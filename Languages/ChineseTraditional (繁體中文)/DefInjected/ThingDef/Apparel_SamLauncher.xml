  <DMSE_Apparel_SamLauncher.verbs.fire_missile.label>發射導彈</DMSE_Apparel_SamLauncher.verbs.fire_missile.label>
  <!-- EN: launch loitering munition -->
  <DMSE_Apparel_SamLauncher.verbs.launch_loitering_munition.label>發射巡飛彈</DMSE_Apparel_SamLauncher.verbs.launch_loitering_munition.label>
  
