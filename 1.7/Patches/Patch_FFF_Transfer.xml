       框架不寫死（docs/轉移船與BVR移植FFF_可行性評估.md §2.1、§3.3）。 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/Fortified.TransferFlightTuningDef[defName="FFF_TransferFlightTuning"]</xpath>
    <value>
      <impactResearch>DMSE_Occultech_TerminalCruise</impactResearch>
      <impactWorkerClass>DMSE.TransferImpactWorker_Hellfire</impactWorkerClass>
    </value>
  </Operation>
</Patch>
