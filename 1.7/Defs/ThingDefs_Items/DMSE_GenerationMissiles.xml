<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       三代裝備體系的新導彈物品（docs/三代裝備體系_實作計畫.md §4、§11-1）
       Missile items added by the three-generation equipment plan.

       - 固定構型（V1、萊茵女兒）沒有 CompMissileConfig，以 DMSE.MissileItemExtension 宣告彈體，
         讓同一條發射軌可以裝不同型號。
       - 有槽位的（刺針、小牛、麻雀、鷹擊）用 CompMissileConfig；costList 已含彈體預設零件的材料。
       - 用途（MissileRoleExtension）：攔截彈只會被 SAM 取用；對地彈只會被對地發射軌與波次打擊取用。
       ================================================================== -->

  <!-- ==================== 老式巡飛彈「V1」==================== -->
  <ThingDef ParentName="DMSE_ResourceBase">
    <defName>DMSE_Missile_LegacyLoiter</defName>
    <label>legacy loitering munition</label>
    <description>An early pulsejet loitering munition flown along a preset heading by a clockwork autopilot. It is slow, loud and inaccurate, but simple enough to build from little more than steel and fuel.\n\nFired from a launch rail. Comes in a fixed configuration.</description>
    <descriptionHyperlinks>
      <ThingDef>DMSE_Building_LoiteringLauncher</ThingDef>
      <ThingDef>DMSE_Building_RotaryLauncher</ThingDef>
      <ThingDef>DMSE_LoiteringRack</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Missile/V1/ammo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4.65,4.65)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <tickerType>Rare</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>700</MarketValue>
      <Mass>120</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>10.0</DeteriorationRate>
    </statBases>
    <costList>
      <Chemfuel>75</Chemfuel>
      <Steel>60</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>DMS_TableMachinePrinter</li>
      </recipeUsers>
      <researchPrerequisite>DMSE_LoiteringMunitions</researchPrerequisite>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </recipeMaker>
    <modExtensions>
      <li Class="DMSE.MissileItemExtension">
        <body>DMSE_MissileBody_LegacyLoiter</body>
      </li>
      <li Class="DMSE.MissileRoleExtension">
        <role>Strike</role>
      </li>
    </modExtensions>
    <comps>
      <li Class="DMSE.CompProperties_DurabilityDecay">
        <hitPointsPerDay>5</hitPointsPerDay>
        <destroyWhenDepleted>true</destroyWhenDepleted>
        <shelterBuildings>
          <li>DMSE_LoiteringRack</li>
          <li>DMSE_Building_LoiteringLauncher</li>
          <li>DMSE_Building_RotaryLauncher</li>
        </shelterBuildings>
      </li>
    </comps>
  </ThingDef>

  <!-- ==================== 老式攔截巡飛彈「萊茵女兒」==================== -->
  <ThingDef ParentName="DMSE_ResourceBase">
    <defName>DMSE_Missile_Rheintochter</defName>
    <label>legacy interceptor loitering munition</label>
    <description>An early guided interceptor with four oversized fins and a radio command link. After launch it circles over the target area until an operator steers it onto an incoming threat. It is slow and rarely hits, but it is a true guided interceptor.\n\nFired by the fire-control network. Comes in a fixed configuration.</description>
    <descriptionHyperlinks>
      <ThingDef>DMSE_Building_LoiteringLauncher</ThingDef>
      <ThingDef>DMSE_Building_RotaryLauncher</ThingDef>
      <ThingDef>DMSE_EarlyFireControlRadar</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Missile/Rheintochter/skyFaller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.25,3.25)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <tickerType>Rare</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>500</MarketValue>
      <Mass>60</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>10.0</DeteriorationRate>
    </statBases>
    <costList>
      <Chemfuel>50</Chemfuel>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>DMS_TableMachinePrinter</li>
      </recipeUsers>
      <researchPrerequisite>DMSE_LoiteringMunitions</researchPrerequisite>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </recipeMaker>
    <modExtensions>
      <li Class="DMSE.MissileItemExtension">
        <body>DMSE_MissileBody_LegacyInterceptor</body>
      </li>
      <!-- 只作攔截彈：發射軌的對地射擊不會取用它。 -->
      <li Class="DMSE.MissileRoleExtension">
        <role>Interceptor</role>
      </li>
    </modExtensions>
    <comps>
      <li Class="DMSE.CompProperties_Renameable" />
      <li Class="DMSE.CompProperties_DurabilityDecay">
        <hitPointsPerDay>5</hitPointsPerDay>
        <destroyWhenDepleted>true</destroyWhenDepleted>
        <shelterBuildings>
          <li>DMSE_LoiteringRack</li>
          <li>DMSE_Building_LoiteringLauncher</li>
          <li>DMSE_Building_RotaryLauncher</li>
        </shelterBuildings>
      </li>
    </comps>
  </ThingDef>

  <!-- ==================== 輕型防空導彈「刺針」====================
       攔截彈，也是單兵防空導彈發射具（DMSE_Apparel_SamLauncher）裝填的彈藥：質量刻意壓低。 -->
  <ThingDef ParentName="DMSE_ResourceBase">
    <defName>DMSE_Missile_Stinger</defName>
    <label>light surface-to-air missile</label>
    <description>A slim, man-portable heat-seeking anti-air missile. It has a short range and a small warhead, and struggles against fast or agile targets, but it fits in almost any launcher.</description>
    <descriptionHyperlinks>
      <ThingDef>DMSE_Apparel_SamLauncher</ThingDef>
      <ThingDef>DMSE_Building_RotaryMissileLauncher</ThingDef>
      <ThingDef>DMSE_Building_FieldAirDefense</ThingDef>
      <ThingDef>DMSE_Building_LightMissileLauncher</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/DMSE_Projectile_Stinger</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.33,1.33)</drawSize>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>800</MarketValue>
      <Mass>15</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>10.0</DeteriorationRate>
    </statBases>
    <costList>
      <Chemfuel>30</Chemfuel>
      <Tungsteel>7</Tungsteel>
      <ComponentStamped>2</ComponentStamped>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>DMS_TableMachinePrinter</li>
      </recipeUsers>
      <researchPrerequisite>DMSE_FireControlNetwork</researchPrerequisite>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </recipeMaker>
    <modExtensions>
      <li Class="DMSE.MissileRoleExtension">
        <role>Interceptor</role>
      </li>
    </modExtensions>
    <comps>
      <li Class="DMSE.CompProperties_Renameable" />
      <li Class="DMSE.CompProperties_MissileConfig">
        <defaultBody>DMSE_MissileBody_Stinger</defaultBody>
      </li>
      <li Class="DMSE.CompProperties_DurabilityDecay">
        <hitPointsPerDay>5</hitPointsPerDay>
        <destroyWhenDepleted>true</destroyWhenDepleted>
        <shelterBuildings>
          <li>DMSE_MissileRack</li>
          <li>DMSE_Building_LightMissileLauncher</li>
          <li>DMSE_Building_LightMissileVLS</li>
          <li>DMSE_Building_RotaryLauncher</li>
          <li>DMSE_Building_RotaryMissileLauncher</li>
          <li>DMSE_Building_FieldAirDefense</li>
        </shelterBuildings>
      </li>
    </comps>
    <inspectorTabs>
      <li>DMSE.ITab_MissileAssembly</li>
    </inspectorTabs>
  </ThingDef>

