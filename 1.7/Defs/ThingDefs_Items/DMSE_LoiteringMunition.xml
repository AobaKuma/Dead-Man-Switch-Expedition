<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 反艦巡飛彈「白蟻」（物品型態）。會隨時間劣化，需存放於巡飛彈儲存架或裝填於發射架內。
       無 CompMissileConfig / ITab：不可自定義（customizeLocation=None），以 MissileItemExtension 宣告彈體，
       讓同一條發射軌也能裝 V1（DMSE_Missile_LegacyLoiter，DMSE_GenerationMissiles.xml）。
       渲染：裝填於發射架後由 CompMissileRackRenderer 依建築朝向繪製折翼彈體（Termite 折疊貼圖）。 -->
  <ThingDef ParentName="DMSE_ResourceBase">
    <defName>DMSE_Missile_Termite</defName>
    <label>anti-ship loitering munition</label>
    <description>A folding-wing anti-ship loitering munition that skims the sea on a small turbojet and uses a passive radar and infrared seeker to find a hull in the terminal phase, slow and modestly armed but cheap, launchable from a ground rail, and inclined to go after moving ships, which is enough against an opponent without an Aegis system.</description>
    <descriptionHyperlinks>
      <ThingDef>DMSE_Building_LoiteringLauncher</ThingDef>
      <ThingDef>DMSE_Building_RotaryLauncher</ThingDef>
      <ThingDef>DMSE_LoiteringRack</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Missile/Termite/missile_fold</texPath>
      <drawSize>3</drawSize>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <!-- Rare ticker 讓 CompDurabilityDecay 能在物品 Spawned 時運作（ResourceBase 預設為 Never）。 -->
    <tickerType>Rare</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>900</MarketValue>
      <Mass>120</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>10.0</DeteriorationRate>
    </statBases>
    <costList>
      <Chemfuel>90</Chemfuel>
      <Steel>70</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>DMS_TableMachinePrinter</li>
      </recipeUsers>
      <researchPrerequisite>DMSE_AntishipMissiles</researchPrerequisite>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </recipeMaker>
    <modExtensions>
      <li Class="DMSE.MissileItemExtension">
        <body>DMSE_MissileBody_Loiter</body>
      </li>
    </modExtensions>
    <comps>
      <!-- 未存放於庇護建築（儲存架/發射架）內時緩慢扣耐久；歸零後摧毀。5 HP/日 ≒ 12 日（60 HP）。 -->
      <li Class="DMSE.CompProperties_DurabilityDecay">
        <hitPointsPerDay>5</hitPointsPerDay>
        <destroyWhenDepleted>true</destroyWhenDepleted>
        <shelterBuildings>
          <li>DMSE_LoiteringRack</li>
          <li>DMSE_Building_LoiteringLauncher</li>
          <li>DMSE_Building_RotaryLauncher</li>
        </shelterBuildings>
      </li>
    </comps>
  </ThingDef>

</Defs>
