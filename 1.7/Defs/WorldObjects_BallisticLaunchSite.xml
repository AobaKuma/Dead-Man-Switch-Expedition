<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ══════════════════════════════════════════════════════════════
       彈道發射場（docs/彈道發射場_實作計畫.md）
       ‧ 出現：玩家完成彈道平台研究（DMSE_Ballistics）後，說書人的大型威脅事件；離殖民地 25–45 格，射程 80 格。
       ‧ 長期存在：不轉移、不逾時，直到火控雷達全滅；不計入其他 NPC 陣地的共同上限，也不被它們擋住（只限自己一座）。
       ‧ 世界層：每 5–8 天以民兵三型級彈道導彈齊射 1–2 枚；面對強大防空時可混入誘餌／分導彈頭
         （不看陣營準則，任何擁有者都會用；仍需「NPC 分導」設定開啟，見 docs/MIRV分導彈頭與誘餌載荷_實作計畫.md §10）。
       ‧ 地圖層：戰略發射井陣位（DMSE_Ballistic_SiloPad）。生成時裝好，發射後守軍 siloReloadDays 天後重新裝配。
       ‧ 摧毀條件同其他陣地：火控雷達全滅。
       版型群組與野戰陣地共用 LaunchSite_Mid.xml 的結構；守軍、道路、礦塊與殘渣步驟直接引用野戰陣地與導彈陣地的 GenStepDef。
       ══════════════════════════════════════════════════════════════ -->

  <GenStepDef>
    <defName>DMSE_BallisticLaunchSite_GS_Structures</defName>
    <order>400</order>
    <genStep Class="Fortified.GenStep_FieldLaunchSite">
      <difficultyThresholds>
        <li>0.5</li>
        <li>0.9</li>
        <li>1.4</li>
      </difficultyThresholds>
      <groups>
        <li>
          <label>search radar</label>
          <pool>
            <li>DMSE_Mid_SearchRadar</li>
          </pool>
          <countByTier>
            <li>1</li>
          </countByTier>
          <radius>0~25</radius>
          <randomRotation>false</randomRotation>
        </li>
        <li>
          <label>fire control radar</label>
          <pool>
            <li>DMSE_Mid_FireControlRadar</li>
          </pool>
          <countByTier>
            <li>1</li>
            <li>1~2</li>
            <li>2</li>
            <li>2~3</li>
          </countByTier>
          <radius>16~32</radius>
          <spacing>6</spacing>
        </li>
        <!-- 發射井陣位：分散在外圈，彼此留 8 格，避免一發打掉兩座。 -->
        <li>
          <label>silo pad</label>
          <pool>
            <li>DMSE_Ballistic_SiloPad</li>
          </pool>
          <countByTier>
            <li>2</li>
            <li>2~3</li>
            <li>3</li>
            <li>3~4</li>
          </countByTier>
          <radius>28~54</radius>
          <spacing>8</spacing>
        </li>
        <li>
          <label>CIWS</label>
          <pool>
            <li>DMSE_Mid_CIWS</li>
          </pool>
          <countByTier>
            <li>1</li>
            <li>1~2</li>
            <li>2</li>
            <li>2~3</li>
          </countByTier>
          <radius>18~46</radius>
          <spacing>6</spacing>
        </li>
        <li>
          <label>rest room</label>
          <pool>
            <li>DMSE_Mid_RestRoom_A</li>
            <li>DMSE_Mid_RestRoom_B</li>
          </pool>
          <countByTier>
            <li>1</li>
            <li>1~2</li>
            <li>2</li>
            <li>2</li>
          </countByTier>
          <radius>20~44</radius>
          <spacing>6</spacing>
        </li>
        <li>
          <label>war room</label>
          <pool>
            <li>DMSE_Mid_WarRoom_A</li>
          </pool>
          <countByTier>
            <li>1</li>
          </countByTier>
          <radius>20~44</radius>
          <spacing>6</spacing>
        </li>
      </groups>
    </genStep>
  </GenStepDef>

  <MapGeneratorDef ParentName="MapCommonBase">
    <defName>DMSE_BallisticLaunchSite_MapGen</defName>
    <genSteps>
      <li>RocksFromGrid</li>
      <li>DMSE_MissileBase_GS_ScatterLumps</li>
      <li>DMSE_BallisticLaunchSite_GS_Structures</li>
      <li>DMSE_FieldLaunchSite_GS_SpawnCrew</li>
      <li>DMSE_FieldLaunchSite_GS_Roads</li>
      <li>DMSE_MissileBase_GS_ScatterSlag</li>
    </genSteps>
  </MapGeneratorDef>

  <WorldObjectDef>
    <defName>DMSE_BallisticLaunchSite</defName>
    <label>ballistic launch site</label>
    <description>A permanent strategic missile site: hardened silos, fire control radars and a garrison that reloads each silo a few days after it fires. It stays until its fire control radars are destroyed.</description>
    <worldObjectClass>RimWorld.Planet.Site</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <saved>true</saved>
    <selectable>true</selectable>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>65</expandingIconPriority>
    <mapGenerator>DMSE_BallisticLaunchSite_MapGen</mapGenerator>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
      <!-- 只在尚未生成地圖時使用；地圖生成後由實際雷達接手。比野戰陣地強一級。 -->
      <li Class="Fortified.WorldObjectCompProperties_AirDefense">
        <worldDetectionRange>14</worldDetectionRange>
        <antiStealthLevel>2</antiStealthLevel>
        <fireControlDef>DMSE_FireControlRadar</fireControlDef>
        <channels>3</channels>
        <interceptorStock>6</interceptorStock>
        <restockPerDay>2</restockPerDay>
        <interceptorBody>DMSE_MissileBody_Light</interceptorBody>
        <interceptorWarhead>DMSE_Light_Warhead_ContinuousRod</interceptorWarhead>
        <launchCooldownTicks>360</launchCooldownTicks>
        <worldInterceptRange>8</worldInterceptRange>
      </li>
      <li Class="Fortified.WorldObjectCompProperties_MissileBase">
        <missileFireIntervalDays>
          <min>5</min>
          <max>8</max>
        </missileFireIntervalDays>
        <missilesPerSalvo>
          <min>1</min>
          <max>2</max>
        </missilesPerSalvo>
        <missileBody>DMSE_MissileBody_AdvancedBallistic</missileBody>
        <!-- 基本彈：低當量／空爆／子母，慣性或星光導引，有時帶突防載荷。不用熱核：一發清空殖民地不是好的威脅。 -->
        <partOptions>
          <li>
            <category>Warhead</category>
            <parts>
              <li>DMSE_AdvBallistic_Warhead_LowYield</li>
              <li>DMSE_Ballistic_Warhead_Airburst</li>
              <li>DMSE_Ballistic_Warhead_ClusterBomblet</li>
            </parts>
          </li>
          <li>
            <category>Guidance</category>
            <parts>
              <li>DMSE_Ballistic_Guidance_Inertial</li>
              <li>DMSE_AdvBallistic_Guidance_Stellar</li>
            </parts>
          </li>
          <li>
            <category>Payload</category>
            <parts>
              <li>DMSE_Ballistic_Payload_None</li>
              <li>DMSE_AdvBallistic_Payload_Penaids</li>
            </parts>
          </li>
        </partOptions>
        <!-- 齊射預算以航跡數計（NpcMirvUtility.TrackCount）。分導梯次標 mirv：本站點 mirvIgnoresDoctrine，只看 Mod 設定。
             梯次的 partOptions 會整份取代上面的基本部件，所以每個梯次都要列出戰鬥部與導引。 -->
        <adaptiveSalvo>
          <alpha>0.6</alpha>
          <exponent>0.7</exponent>
          <maxPerSalvo>4</maxPerSalvo>
          <tiers>
            <li>
              <minEffective>2</minEffective>
              <chance>0.35</chance>
              <partOptions>
                <li>
                  <category>Warhead</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Warhead_LowYield</li>
                    <li>DMSE_Ballistic_Warhead_Airburst</li>
                    <li>DMSE_Ballistic_Warhead_ClusterBomblet</li>
                  </parts>
                </li>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_Ballistic_Guidance_Inertial</li>
                    <li>DMSE_AdvBallistic_Guidance_Stellar</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Payload_Penaids</li>
                  </parts>
                </li>
              </partOptions>
            </li>
            <li>
              <minEffective>3</minEffective>
              <chance>0.35</chance>
              <mirv>true</mirv>
              <partOptions>
                <li>
                  <category>Warhead</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Warhead_LowYield</li>
                    <li>DMSE_Ballistic_Warhead_Airburst</li>
                    <li>DMSE_Ballistic_Warhead_ClusterBomblet</li>
                  </parts>
                </li>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_Ballistic_Guidance_Inertial</li>
                    <li>DMSE_AdvBallistic_Guidance_Stellar</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Payload_Decoys</li>
                  </parts>
                </li>
              </partOptions>
            </li>
            <li>
              <minEffective>5</minEffective>
              <chance>0.3</chance>
              <mirv>true</mirv>
              <partOptions>
                <li>
                  <category>Warhead</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Warhead_LowYield</li>
                    <li>DMSE_Ballistic_Warhead_Airburst</li>
                    <li>DMSE_Ballistic_Warhead_ClusterBomblet</li>
                  </parts>
                </li>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_Ballistic_Guidance_Inertial</li>
                    <li>DMSE_AdvBallistic_Guidance_Stellar</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_AdvBallistic_Payload_MIRV</li>
                    <li>DMSE_AdvBallistic_Payload_MIRVDecoy</li>
                  </parts>
                </li>
              </partOptions>
            </li>
          </tiers>
        </adaptiveSalvo>
        <range>80</range>
        <!-- 固定式戰略站點：不轉移。 -->
        <relocationDays>
          <min>0</min>
          <max>0</max>
        </relocationDays>
        <countsTowardSiteLimit>false</countsTowardSiteLimit>
        <!-- 分導梯次不看陣營準則：任何擁有者都會用誘餌與分導彈頭（仍需 Mod 設定「NPC 分導」開啟）。 -->
        <mirvIgnoresDoctrine>true</mirvIgnoresDoctrine>
        <siloReloadDays>4</siloReloadDays>
        <reentryBlockedDays>
          <min>1</min>
          <max>2</max>
        </reentryBlockedDays>
        <incomingWorldObjectDef>DMSE_WorldObject_IncomingMissile</incomingWorldObjectDef>
        <supplyDrop>
          <intervalDays>2~4</intervalDays>
          <perPawn>8</perPawn>
          <maxStockPerPawn>12</maxStockPerPawn>
        </supplyDrop>
        <turretAmmo>
          <intervalDays>2~4</intervalDays>
          <refillBelowPercent>0.5</refillBelowPercent>
          <refillToPercent>1</refillToPercent>
          <haulDelayTicks>300</haulDelayTicks>
          <maxHaulers>1</maxHaulers>
        </turretAmmo>
        <nextFireInspectKey>DMSE.MissileBase.NextFireIn</nextFireInspectKey>
        <localMonitoringInspectKey>DMSE.MissileBase.LocalMonitoring</localMonitoringInspectKey>
      </li>
    </comps>
  </WorldObjectDef>

  <SitePartDef>
    <defName>DMSE_BallisticLaunchSitePart</defName>
    <label>ballistic launch site</label>
    <description>A strategic missile site with hardened silos, fire control radars and a garrison.</description>
    <!-- FactionCanOwn：至少工業等級的人類派系（含海盜）。 -->
    <workerClass>Fortified.SitePartWorker_BallisticLaunchSite</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <!-- 暫用強化陣地的巡航圖示，待專屬圖示。 -->
    <expandingIconTexture>UI/Icon/icon_FortifiedLaunchSite_Cruise</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <requiresFaction>true</requiresFaction>
    <minFactionTechLevel>Industrial</minFactionTechLevel>
    <tags>
      <li>DMSE_BallisticLaunchSite</li>
    </tags>
    <wantsThreatPoints>true</wantsThreatPoints>
    <forceExitAndRemoveMapCountdownDurationDays>0</forceExitAndRemoveMapCountdownDurationDays>
  </SitePartDef>

  <!-- 說書人的大型威脅：玩家完成彈道平台研究後，敵對派系在遠處建立長期彈道發射場。世界上同時只有一座。 -->
  <IncidentDef>
    <defName>DMSE_BallisticLaunchSiteDeployed</defName>
    <label>ballistic launch site established</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Fortified.IncidentWorker_FieldLaunchSite</workerClass>
    <baseChance>0.4</baseChance>
    <earliestDay>30</earliestDay>
    <minRefireDays>45</minRefireDays>
    <minThreatPoints>1000</minThreatPoints>
    <letterLabel>Enemy ballistic launch site</letterLabel>
    <letterDef>ThreatBig</letterDef>
    <modExtensions>
      <li Class="Fortified.FieldLaunchSiteIncidentExtension">
        <worldObjectDef>DMSE_BallisticLaunchSite</worldObjectDef>
        <sitePartDef>DMSE_BallisticLaunchSitePart</sitePartDef>
        <distance>25~45</distance>
        <maxActiveSites>1</maxActiveSites>
        <countOwnKindOnly>true</countOwnKindOnly>
        <threatPoints>1000~5000</threatPoints>
        <requiredResearch>DMSE_Ballistics</requiredResearch>
        <spawnedLetterKey>DMSE.BallisticLaunchSite.SpawnedLetter</spawnedLetterKey>
      </li>
    </modExtensions>
  </IncidentDef>

</Defs>
