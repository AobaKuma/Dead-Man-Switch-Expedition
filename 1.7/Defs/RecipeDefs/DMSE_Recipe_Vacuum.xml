<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <!-- DMSE_Vacuum_Recipe：移到 FFF（2026-11-27），這裡只留別名讓既有子 Def 與其他模組的引用不用改。 -->
  <RecipeDef Name="DMSE_Vacuum_Recipe" ParentName="FFF_VacuumRecipeBase" Abstract="True" />

<!-- Sintering furnace -->
  <!-- Tantasteel -->
  <RecipeDef ParentName="DMSE_Vacuum_Recipe">
    <defName>DMSE_Make_TantastenAlloy</defName>
    <label>Make Tantasteel x25</label>
    <description>Sinter a small amount of Tantasteel.</description>
    <jobString>Sintering.</jobString>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>DMS_Furnace</li>
      <li>DMS_LabFurnace</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>DMSE_VacuumMaterial</researchPrerequisite>
    <workAmount>30000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Tungsteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksVacstone</li>
          </thingDefs>
        </filter>
        <count>125</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Tungsteel</li>
        <li>BlocksVacstone</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <DMSE_TantastenAlloy>25</DMSE_TantastenAlloy>
    </products>
  </RecipeDef>
  
  <!-- Tantasteel (bulk) -->
  <RecipeDef ParentName="DMSE_Vacuum_Recipe">
    <defName>DMSE_Make_TantastenAlloyMass</defName>
    <label>Make Tantasteel x100</label>
    <description>Sinter a large amount of Tantasteel.</description>
    <jobString>Sintering.</jobString>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>DMS_Furnace</li>
      <!-- <li>DMS_LabFurnace</li> Due to current limitations, this recipe cannot be enabled on the laboratory furnace. -->
    </recipeUsers>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>DMSE_VacuumMaterial</researchPrerequisite>
    <workAmount>45000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Tungsteel</li>
          </thingDefs>
        </filter>
        <count>200</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksVacstone</li>
          </thingDefs>
        </filter>
        <count>500</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Tungsteel</li>
        <li>BlocksVacstone</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <DMSE_TantastenAlloy>100</DMSE_TantastenAlloy>
    </products>
  </RecipeDef>

</Defs>	