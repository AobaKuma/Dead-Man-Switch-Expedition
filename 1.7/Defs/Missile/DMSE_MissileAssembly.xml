<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 彈體 ==================== -->
  <DMSE.MissileBodyDef>
    <defName>DMSE_MissileBody_Cruise</defName>
    <label>cruise missile body</label>
    <description>The standard chassis of the Scorer cruise missile. Provides four assembly slots for warhead, guidance, propulsion, and special payload.</description>
    <!-- 四階分類：中型導彈（巡航/反彈道）。現有 cruise 作為中型階的基礎範本。 -->
    <sizeClass>Medium</sizeClass>
    <launchMode>Both</launchMode>
    <customizeLocation>Item</customizeLocation>
    <baseExplosionRadius>6</baseExplosionRadius>
    <baseDamageDef>Bomb</baseDamageDef>
    <baseDamageAmount>120</baseDamageAmount>
    <baseScatter>3</baseScatter>
    <baseWorldSpeedFactor>1</baseWorldSpeedFactor>
    <baseRange>0</baseRange>
    <!-- 具導引能力時，飛行中可更新終端位置的次數（資料鏈可多次修正） -->
    <terminalUpdates>3</terminalUpdates>
    <baseFuel>100</baseFuel>
    <baseSpecificImpulse>3</baseSpecificImpulse>
    <rangePerFuelImpulse>0.1</rangePerFuelImpulse>
    <incomingSkyfaller>DMSE_Incoming_CruiseMissile</incomingSkyfaller>
    <launchProjectile>DMSE_Launch_Cruise</launchProjectile>
    <slots>
      <li>Warhead</li>
      <li>Guidance</li>
      <li>Propulsion</li>
      <li>Payload</li>
    </slots>
    <!-- 建造時自帶：材料已含在物品 costList 內。 -->
    <defaultParts>
      <li>DMSE_Warhead_HE</li>
      <li>DMSE_Guidance_Inertial</li>
      <li>DMSE_Propulsion_Standard</li>
      <li>DMSE_Payload_None</li>
    </defaultParts>
  </DMSE.MissileBodyDef>

  <!-- ==================== 彈頭 Warhead ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_HE</defName>
    <label>high-explosive warhead</label>
    <description>A large blast warhead. Wide radius, high damage.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <explosionRadiusOffset>2</explosionRadiusOffset>
    <damageAmountOffset>60</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>30</Steel>
      <Chemfuel>20</Chemfuel>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_AP</defName>
    <label>armor-piercing warhead</label>
    <description>A focused penetrator. Smaller radius but far higher damage.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <explosionRadiusOffset>-2</explosionRadiusOffset>
    <damageAmountOffset>140</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>40</Steel>
      <DMSE_TantastenAlloy>5</DMSE_TantastenAlloy>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_EMP</defName>
    <label>EMP warhead</label>
    <description>Disables mechanoids and stuns targets in a wide area without lethal blast.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <explosionRadiusOffset>1</explosionRadiusOffset>
    <damageDefOverride>EMP</damageDefOverride>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 導引 Guidance ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Inertial</defName>
    <label>inertial guidance</label>
    <description>Baseline guidance. Average accuracy.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <scatterOffset>0</scatterOffset>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Precision</defName>
    <label>TV guidance</label>
    <description>An operator-guided TV seeker with a datalink back to the launch site. When the missile reaches the target map, the game pauses and you choose the impact point freely. Greatly tightens impact dispersion. Enemy-launched TV missiles have no operator and fall back to inertial targeting.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <!-- 電視制導：玩家發射時抵達後手動選點；具導引能力（可跨圖層、可追蹤移動目標） -->
    <guidanceType Class="DMSE.GuidanceType_TV" />
    <scatterOffset>-2.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_EMSignal</defName>
    <label>electromagnetic-signal seeker</label>
    <description>Passive seeker that homes on electromagnetic emissions from power lines and machinery. Locks onto the powered enemy building drawing the most electricity on the target map. Falls back to inertial targeting if nothing is powered.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_ElectromagneticSignal" />
    <scatterOffset>-1.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_RadarBasis</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_AntiShip</defName>
    <label>anti-ship radar seeker</label>
    <description>An active radar seeker built for moving targets: ships and any other mobile base on the world map. It keeps re-aiming while the target keeps moving and does so more often than a normal seeker; the missile still misses if the target leaves its remaining range.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_AntiShip" />
    <scatterOffset>-2</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Laser</defName>
    <label>laser seeker</label>
    <description>Semi-active laser seeker. Locks onto the most recent laser designation your faction has painted on the target map with a laser target designator. Falls back to inertial targeting if there is none.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Laser" />
    <scatterOffset>-2.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 推進／射程 Propulsion ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Propulsion_Standard</defName>
    <label>standard motor</label>
    <description>Baseline solid-fuel motor.</description>
    <category>Propulsion</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Propulsion_Booster</defName>
    <label>boosted motor</label>
    <description>A higher-impulse motor that reaches the target faster and extends range.</description>
    <category>Propulsion</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <worldSpeedFactorOffset>0.6</worldSpeedFactorOffset>
    <specificImpulseOffset>2</specificImpulseOffset>
    <costList>
      <Chemfuel>40</Chemfuel>
      <Steel>20</Steel>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 特殊酬載 Payload ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_Cluster</defName>
    <label>cluster submunitions</label>
    <description>Releases a secondary blast across the impact area.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <payloadExplosionRadius>4</payloadExplosionRadius>
    <payloadDamageDef>Bomb</payloadDamageDef>
    <payloadDamageAmount>40</payloadDamageAmount>
    <costList>
      <Steel>25</Steel>
      <Chemfuel>15</Chemfuel>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_None</defName>
    <label>no payload</label>
    <description>No secondary payload. The warhead alone has to be enough, which keeps the Scorer airframe light and its range long.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_EMP</defName>
    <label>EMP submunitions</label>
    <description>A secondary EMP burst that stuns and disables electronics around the impact.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Cruise</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li></compatibleBodies>
    <payloadExplosionRadius>5</payloadExplosionRadius>
    <payloadDamageDef>EMP</payloadDamageDef>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

</Defs>
