<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 彈體 ==================== -->

  <!-- ==================== 彈頭 Warhead ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_HE</defName>
    <label>high-explosive warhead</label>
    <description>A large high-explosive warhead with a wide blast radius.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <explosionRadiusOffset>2</explosionRadiusOffset>
    <damageAmountOffset>60</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>30</Steel>
      <Chemfuel>20</Chemfuel>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_AP</defName>
    <label>armor-piercing warhead</label>
    <description>A focused penetrating warhead. Its blast radius is smaller, but it does far more damage.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <explosionRadiusOffset>-2</explosionRadiusOffset>
    <damageAmountOffset>140</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>40</Steel>
      <DMSE_TantastenAlloy>5</DMSE_TantastenAlloy>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Warhead_EMP</defName>
    <label>EMP warhead</label>
    <description>An EMP warhead that disables mechanoids and electronics over a wide area without a lethal blast.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <explosionRadiusOffset>1</explosionRadiusOffset>
    <damageDefOverride>EMP</damageDefOverride>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 導引 Guidance ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Inertial</defName>
    <label>inertial guidance</label>
    <description>Inertial guidance with no target recognition and no terminal guidance. Impacts scatter around the center of the target map. It does not lock onto buildings or creatures.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Inertial" />
    <scatterOffset>0</scatterOffset>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_ActiveRadar</defName>
    <label>active radar seeker</label>
    <description>A fire-and-forget active radar seeker. It targets the largest enemy building, or the largest enemy creature if there are no buildings, and falls back to inertial guidance if it finds nothing. Provides terminal guidance.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_Light</li><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_LegacyBallistic</li><li>DMSE_MissileBody_AdvancedLight</li><li>DMSE_MissileBody_AdvancedCruise</li><li>DMSE_MissileBody_Stinger</li><li>DMSE_MissileBody_Maverick</li><li>DMSE_MissileBody_Sparrow</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_ActiveRadar" />
    <scatterOffset>-1.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Precision</defName>
    <label>TV guidance</label>
    <description>An operator-guided TV seeker with a datalink to the launch site. When the missile reaches the target map, the game pauses and you choose the impact point. Greatly tightens dispersion. Enemy TV missiles have no operator and use inertial guidance instead.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <!-- 電視制導：玩家發射時抵達後手動選點；具導引能力（可跨圖層、可追蹤移動目標） -->
    <guidanceType Class="DMSE.GuidanceType_TV" />
    <scatterOffset>-2.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_EMSignal</defName>
    <label>electromagnetic-signal seeker</label>
    <description>A passive seeker that homes on electrical activity. It targets the powered enemy building drawing the most electricity, and falls back to inertial guidance if nothing is powered.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_ElectromagneticSignal" />
    <scatterOffset>-1.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_AntiShip</defName>
    <label>anti-ship radar seeker</label>
    <description>An active radar seeker built for moving targets, such as ships and other mobile bases on the world map. It updates its aim more often than a normal seeker, but the missile still misses if the target moves out of its remaining range.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_AntiShip" />
    <scatterOffset>-2</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Guidance_Laser</defName>
    <label>laser seeker</label>
    <description>A semi-active laser seeker. It homes on the most recent point your colony marked on the target map with a laser target designator, and falls back to inertial guidance if there is none.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Laser" />
    <scatterOffset>-2.5</scatterOffset>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 推進／射程 Propulsion ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Propulsion_Standard</defName>
    <label>standard motor</label>
    <description>A standard solid-fuel rocket motor.</description>
    <category>Propulsion</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Propulsion_Booster</defName>
    <label>boosted motor</label>
    <description>A more powerful motor that reaches the target faster and flies farther.</description>
    <category>Propulsion</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <worldSpeedFactorOffset>0.6</worldSpeedFactorOffset>
    <specificImpulseOffset>2</specificImpulseOffset>
    <costList>
      <Chemfuel>40</Chemfuel>
      <Steel>20</Steel>
    </costList>
  </DMSE.MissilePartDef>

  <!-- ==================== 特殊酬載 Payload ==================== -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_Cluster</defName>
    <label>cluster submunitions</label>
    <description>Releases submunitions that cause a second blast across the impact area.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <payloadExplosionRadius>4</payloadExplosionRadius>
    <payloadDamageDef>Bomb</payloadDamageDef>
    <payloadDamageAmount>40</payloadDamageAmount>
    <costList>
      <Steel>25</Steel>
      <Chemfuel>15</Chemfuel>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_None</defName>
    <label>no payload</label>
    <description>No secondary charge. The warhead does all the work, keeping the missile light and its range long.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
  </DMSE.MissilePartDef>

  <!-- 反碉堡酬載：穿透厚岩頂後在內部引爆；小半徑高穿甲爆炸，並對爆心附近建築施加額外結構傷害。
       沒有它（或鎢芯穿甲戰鬥部）的導彈打在厚岩頂上只在岩層表面引爆，導引頭也不鎖定岩頂下的目標。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_BunkerBuster</defName>
    <label>bunker buster payload</label>
    <description>A hardened penetrator charge with a delayed fuze. It bores through thick rock roofs and detonates inside, wrecking nearby structures.\n\nWithout this or a penetrator warhead, a missile that hits a mountain detonates on the rock surface, and its seeker ignores targets under thick roofs.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_BunkerBuster">
      <damageAmount>150</damageAmount>
      <structureDamage>300</structureDamage>
    </payloadEffect>
    <costList>
      <Steel>30</Steel>
      <Plasteel>15</Plasteel>
    </costList>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Payload_EMP</defName>
    <label>EMP submunitions</label>
    <description>A secondary EMP burst that stuns and disables electronics around the impact.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_Moskit</li><li>DMSE_MissileBody_Yj</li><li>DMSE_MissileBody_Tochka</li></compatibleBodies>
    <payloadExplosionRadius>5</payloadExplosionRadius>
    <payloadDamageDef>EMP</payloadDamageDef>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </DMSE.MissilePartDef>

</Defs>
