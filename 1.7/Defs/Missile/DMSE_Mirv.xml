<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       分導重返載具與誘餌（docs/MIRV分導彈頭與誘餌載荷_實作計畫.md）
       這些彈體只在飛行中由彈頭匯流排釋放（releasedInFlight）：
       不從地面發射、不能裝配，所以沒有 launchProjectile、namer 與 defaultParts。
       世界速度與射程一律沿用母彈（MissileWorldObject.SpawnChild），這裡的數值只影響落點結算。
       ================================================================== -->

  <!-- 重返載具（RV）：民兵三型的單枚分導彈頭。繼承母彈的戰鬥部與導引；
       3 RV ×（半徑 6、傷害 140、N 4）的總殺傷面積約為整彈（9／240／N 9）的 1.3 倍，但每枚都要突破防空。 -->
  <Fortified.MissileBodyDef>
    <defName>DMSE_MissileBody_ReentryVehicle</defName>
    <label>re-entry vehicle</label>
    <description>A single warhead released from a strategic missile's post-boost bus. It falls on a ballistic path with the warhead and guidance of the missile that carried it.</description>
    <expandingIconPath>UI/DMSE/TravelingMissile_Expanding_Ballistic</expandingIconPath>
    <sizeClass>Ballistic</sizeClass>
    <launchMode>Vertical</launchMode>
    <customizeLocation>None</customizeLocation>
    <releasedInFlight>true</releasedInFlight>
    <payloadCapacity>4</payloadCapacity>
    <baseExplosionRadius>6</baseExplosionRadius>
    <baseDamageDef>Bomb</baseDamageDef>
    <baseDamageAmount>140</baseDamageAmount>
    <baseScatter>2</baseScatter>
    <baseWorldSpeedFactor>1.7</baseWorldSpeedFactor>
    <terminalUpdates>3</terminalUpdates>
    <baseFuel>180</baseFuel>
    <baseSpecificImpulse>3.2</baseSpecificImpulse>
    <rangePerFuelImpulse>0.8681</rangePerFuelImpulse>
    <incomingSkyfaller>DMSE_Incoming_ReentryVehicle</incomingSkyfaller>
  </Fortified.MissileBodyDef>

  <!-- 誘餌（計畫 §7）：雷達特徵、標籤、圖示與進圖外觀都在釋放時取自它模仿的彈頭
       （跟著 MIRV 像重返載具，跟著單彈頭像整枚導彈），所以這裡的 incomingSkyfaller 只是後備。
       速度、射程與終端更新次數沿用母彈。沒有殺傷：落地是惰性撞擊。 -->

  <!-- 輕型誘餌：充氣反射器，中段很像真彈頭，但重返大氣層時一定燒毀，進不了地圖層。 -->
  <Fortified.MissileBodyDef>
    <defName>DMSE_MissileBody_DecoyLight</defName>
    <label>light decoy</label>
    <description>An inflatable radar reflector shaped like a warhead. In space it looks just like the real thing to enemy radars, but it is far too light to survive re-entry and burns up before it reaches the target.</description>
    <expandingIconPath>UI/DMSE/TravelingMissile_Expanding_Ballistic</expandingIconPath>
    <sizeClass>Ballistic</sizeClass>
    <launchMode>Vertical</launchMode>
    <customizeLocation>None</customizeLocation>
    <releasedInFlight>true</releasedInFlight>
    <payloadCapacity>0</payloadCapacity>
    <baseExplosionRadius>0</baseExplosionRadius>
    <baseDamageAmount>0</baseDamageAmount>
    <baseScatter>3</baseScatter>
    <baseWorldSpeedFactor>1.7</baseWorldSpeedFactor>
    <incomingSkyfaller>DMSE_Incoming_ReentryVehicle</incomingSkyfaller>
    <decoy>
      <mimicBody>DMSE_MissileBody_ReentryVehicle</mimicBody>
      <fidelity>1</fidelity>
      <reentrySurvivalChance>0</reentrySurvivalChance>
    </decoy>
  </Fortified.MissileBodyDef>

  <!-- 重型誘餌：配重的仿真再入體，能撐過再入、以惰性彈進入地圖層，迫近防禦（CIWS）也會對它開火。 -->
  <Fortified.MissileBodyDef>
    <defName>DMSE_MissileBody_DecoyHeavy</defName>
    <label>heavy decoy</label>
    <description>A ballasted dummy re-entry vehicle with the same shape and weight as a warhead. It survives re-entry and falls all the way to the target, drawing fire from close-in defenses, but carries no explosive.</description>
    <expandingIconPath>UI/DMSE/TravelingMissile_Expanding_Ballistic</expandingIconPath>
    <sizeClass>Ballistic</sizeClass>
    <launchMode>Vertical</launchMode>
    <customizeLocation>None</customizeLocation>
    <releasedInFlight>true</releasedInFlight>
    <payloadCapacity>0</payloadCapacity>
    <baseExplosionRadius>0</baseExplosionRadius>
    <baseDamageAmount>0</baseDamageAmount>
    <baseScatter>3</baseScatter>
    <baseWorldSpeedFactor>1.7</baseWorldSpeedFactor>
    <incomingSkyfaller>DMSE_Incoming_ReentryVehicle</incomingSkyfaller>
    <decoy>
      <mimicBody>DMSE_MissileBody_ReentryVehicle</mimicBody>
      <fidelity>2</fidelity>
      <reentrySurvivalChance>1</reentrySurvivalChance>
    </decoy>
  </Fortified.MissileBodyDef>

  <!-- 重返載具落地彈：比整彈小（distanceLevel 0.8），其餘同民兵三型的高超音速再入。
       貼圖是 .source/Tools/gen_reentry_vehicle_texture.py 產生的暫位圖（機頭朝北），待正式美術。 -->
  <ThingDef ParentName="DMSE_MissileIncomingProjectileBase">
    <defName>DMSE_Incoming_ReentryVehicle</defName>
    <label>re-entry vehicle (incoming)</label>
    <thingClass>Fortified.Projectile_MissileIncoming</thingClass>
    <graphicData>
      <texPath>Things/Missile/ReentryVehicle/skyFaller_incoming</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <modExtensions>
      <li Class="Fortified.MissileFlightExtension">
        <shadowSize>(1.5, 1.5)</shadowSize>
        <rotateGraphicTowardsDirection>true</rotateGraphicTowardsDirection>
        <speed>1</speed>
      </li>
      <li Class="Fortified.AirTargetExtension">
        <distanceLevel>0.8</distanceLevel>
        <stealthLevel>2</stealthLevel>
        <speed>95</speed>
        <altitude>100000</altitude>
        <!-- 高超音速再入彈頭：迫近防禦（CIWS）命中率只剩 5%。 -->
        <terminalInterceptFactor>0.05</terminalInterceptFactor>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
