<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       先進巡航導彈（戰斧級）部件
       Advanced cruise missile (Tomahawk-class) parts.

       這個彈體在 1.7 先前只有定義、沒有任何相容部件。本檔補齊四槽：
         - Warhead：WDU-36 級單一高爆／深穿透
         - Guidance：TERCOM/DSMAC 地形比對（低散布、無終端）、雙向資料鏈（飛行中改靶）
         - Propulsion：渦輪扇、增程渦輪扇、固態助推
         - Payload：空、誘餌、集束子彈藥（BLU-97 級）、石墨纖維（電網攻擊）
       數值以現役巡航部件為基準；射程 = 燃料 × 比衝 × 彈體係數（先進巡航 0.3836）。
       ================================================================== -->

  <!-- == Warhead == -->

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Warhead_Unitary</defName>
    <label>unitary penetrating warhead</label>
    <designWord>Unitary</designWord>
    <description>A single large charge in a light, tough casing. It hits harder than the old Scorer warhead and can punch through a roof before it detonates.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <explosionRadiusOffset>1.5</explosionRadiusOffset>
    <damageAmountOffset>110</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>40</Steel>
      <Chemfuel>30</Chemfuel>
      <DMSE_TantastenAlloy>6</DMSE_TantastenAlloy>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Warhead_Penetrator</defName>
    <label>hard-target penetrator</label>
    <designWord>Penetrator</designWord>
    <description>A dense tungsten penetrator that punches through thick roofs and overhead mountain before detonating inside. Underground shelters offer no protection against it.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <explosionRadiusOffset>-1</explosionRadiusOffset>
    <damageAmountOffset>60</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <warheadEffect Class="DMSE.WarheadEffect_TungstenPenetrator">
      <damageAmount>200</damageAmount>
    </warheadEffect>
    <costList>
      <Steel>30</Steel>
      <DMSE_TantastenAlloy>20</DMSE_TantastenAlloy>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- == Guidance == -->

  <!-- TERCOM/DSMAC：貼地飛行、比對地形，散布極小，但沒有終端導引能力。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Guidance_TerrainMatch</defName>
    <label>terrain-matching guidance</label>
    <designWord>TERCOM</designWord>
    <description>Guidance that compares the ground below with a stored map, giving very tight dispersion. It cannot be retargeted in flight and has no terminal guidance, so a moving target is simply missed. Impacts scatter around the center of the target map. It does not lock onto buildings or creatures.</description>
    <category>Guidance</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Inertial" />
    <scatterOffset>-2</scatterOffset>
    <costList>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 雙向資料鏈：飛行中改靶＋終端，玩家選點。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Guidance_Datalink</defName>
    <label>two-way datalink</label>
    <designWord>Datalink</designWord>
    <description>A two-way satellite datalink. The missile can be retargeted in flight, and when it reaches the target map the game pauses so you can pick the impact point. The most accurate option, and the only one that can chase a moving target mid-flight.</description>
    <category>Guidance</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_TV" />
    <scatterOffset>-2.5</scatterOffset>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
      <li>DMSE_RadarNetwork</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 反艦主動雷達：對移動目標的專用導引頭。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Guidance_AntiShip</defName>
    <label>anti-ship radar seeker</label>
    <designWord>Anti-ship</designWord>
    <description>An active radar seeker built for moving targets, such as ships and other mobile bases on the world map. It updates its aim more often than a normal seeker, but the missile still misses if the target moves out of its remaining range.</description>
    <category>Guidance</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_AntiShip" />
    <scatterOffset>-2.5</scatterOffset>
    <costList>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_AntishipMissiles</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- == Propulsion == -->

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Propulsion_Turbofan</defName>
    <label>turbofan sustainer</label>
    <omitFromDesignName>true</omitFromDesignName>
    <description>A small fuel-efficient turbofan engine. It flies much farther than a rocket motor and is harder to spot on radar, but it is slow.</description>
    <category>Propulsion</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <specificImpulseOffset>0.8</specificImpulseOffset>
    <worldSpeedFactorOffset>0.1</worldSpeedFactorOffset>
    <costList>
      <Steel>25</Steel>
      <Chemfuel>30</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Propulsion_TurbofanER</defName>
    <label>extended-range turbofan</label>
    <designWord>ER</designWord>
    <description>A fuel-saving turbofan with a larger tank. It has the longest range of any cruise setup, but it is the slowest to arrive and the most expensive to build.</description>
    <category>Propulsion</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <specificImpulseOffset>1.2</specificImpulseOffset>
    <fuelOffset>10</fuelOffset>
    <worldSpeedFactorOffset>0.15</worldSpeedFactorOffset>
    <costList>
      <Steel>40</Steel>
      <Chemfuel>50</Chemfuel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Propulsion_Booster</defName>
    <label>solid rocket booster</label>
    <designWord>Boost</designWord>
    <description>A solid rocket booster that pushes the missile to high speed, then burns out. It is very fast and very easy to spot, and its weight cuts the missile's range.</description>
    <category>Propulsion</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <specificImpulseOffset>-0.6</specificImpulseOffset>
    <fuelOffset>-15</fuelOffset>
    <worldSpeedFactorOffset>0.5</worldSpeedFactorOffset>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>40</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- == Payload == -->

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_None</defName>
    <label>no payload</label>
    <omitFromDesignName>true</omitFromDesignName>
    <description>No secondary charge. The warhead and fuel tank get all the space.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_Submunition</defName>
    <label>submunition dispenser</label>
    <designWord>Cluster</designWord>
    <description>A dispenser that opens over the target and scatters small bomblets across the area instead of one concentrated blast.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_Cluster">
      <subDamageAmount>90</subDamageAmount>
      <countOverride>6</countOverride>
    </payloadEffect>
    <costList>
      <Steel>40</Steel>
      <Chemfuel>40</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 反碉堡酬載：穿透厚岩頂後在內部引爆；小半徑高穿甲爆炸，並對爆心附近建築施加額外結構傷害。
       沒有它（或鎢芯穿甲戰鬥部）的導彈打在厚岩頂上只在岩層表面引爆，導引頭也不鎖定岩頂下的目標。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_BunkerBuster</defName>
    <label>bunker buster payload</label>
    <designWord>Bunker</designWord>
    <description>A hardened penetrator charge with a delayed fuze. It bores through thick rock roofs and detonates inside, wrecking nearby structures.\n\nWithout this or a penetrator warhead, a missile that hits a mountain detonates on the rock surface, and its seeker ignores targets under thick roofs.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_BunkerBuster">
      <damageAmount>180</damageAmount>
      <structureDamage>400</structureDamage>
    </payloadEffect>
    <costList>
      <Steel>30</Steel>
      <Plasteel>20</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_Graphite</defName>
    <label>graphite filament payload</label>
    <designWord>Graphite</designWord>
    <description>A payload of carbon fibers that shorts out the power grid around the impact instead of exploding. It disables powered buildings and stuns mechanoids over a wide area.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_EMP">
      <empDamage>150</empDamage>
    </payloadEffect>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedAirDefense</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_Decoy</defName>
    <label>decoy payload</label>
    <designWord>Decoy</designWord>
    <description>Radar reflectors and a signal booster in place of a secondary charge. The missile looks twice as large on enemy radar, so it is detected earlier and drawn fire from air defenses that rank threats by size. Adds no damage.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
    <signatureFactor>2</signatureFactor>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_RadarNetwork</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 箔條／干擾絲（巡航版）：次數較多、強度較高。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvCruise_Payload_Chaff</defName>
    <label>chaff dispenser</label>
    <designWord>Chaff</designWord>
    <description>A larger dispenser of chaff and radar-absorbing streamers. Each bundle can break one enemy fire-control lock. It holds more bundles than the light version, but they cannot be reloaded in flight.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedCruise</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
    <jamStrength>0.35</jamStrength>
    <chaffCharges>3</chaffCharges>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_FireControlNetwork</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

</Defs>