<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       世代化彈道部件（V2 老式／民兵三型先進）
       Generation parts for the ballistic airframes.

       三個彈道彈體（V2、現役、民兵三型）共用的 9 個部件放在
       DMSE_BallisticMissile.xml；本檔只放「某一世代專屬」的部件：
         - V2（LegacyBallistic）：阿馬托／特里亞倫炸藥，工業材料即可量產。
         - 先進（AdvancedBallistic）：低當量、星光慣性、突防誘餌、分導。
       ================================================================== -->

  <!-- ══════════════════════════════════════════════════════════════
       一、先進彈道（民兵三型）專屬部件
       ══════════════════════════════════════════════════════════════ -->

  <!-- 低當量彈頭：W78／W87 級戰略彈頭的戰術縮小版；爆炸半徑與傷害小於全當量，但便宜、安全性高。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvBallistic_Warhead_LowYield</defName>
    <label>low-yield warhead</label>
    <description>A reduced-yield strategic warhead of the W78/W87 class scaled down for tactical use. Smaller blast and less damage than the full thermonuclear package, but far cheaper and safer to keep on alert.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>-3</explosionRadiusOffset>
    <damageAmountOffset>-80</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>50</Steel>
      <Chemfuel>40</Chemfuel>
      <DMSE_TantastenAlloy>8</DMSE_TantastenAlloy>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 星光慣性導航：以星象追蹤修正陀螺漂移，散布 -4；仍是純彈道路徑，目標移動就會落空。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvBallistic_Guidance_Stellar</defName>
    <label>stellar-inertial guidance</label>
    <description>A stellar-updated inertial platform in the NS-50 tradition: star trackers trim the drift of the gyros during the coast, cutting dispersion to almost nothing. It is still a ballistic path with no terminal seeker, so a target that moves is still missed.</description>
    <category>Guidance</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Inertial" />
    <scatterOffset>-4</scatterOffset>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentStamped>3</ComponentStamped>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 突防誘餌：釋放箔條、雷達誘餌與低可觀測外罩，訊號係數 0.75（更晚被偵測）。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_Penaids</defName>
    <label>penetration aids</label>
    <description>Chaff, radar decoys and a low-observable shroud released with the re-entry vehicle. The missile shows up as a much smaller target on the way in, so enemy radars pick it up later and have less time to engage it.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
    <signatureFactor>0.75</signatureFactor>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 多彈頭：在大氣層外釋放多枚獨立再入載具；目前實作為單一落點周圍散布子彈藥
       （真正的多目標需要不同的落點模型）。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_MIRV</defName>
    <label>multiple re-entry vehicles</label>
    <description>A bus of several independent re-entry vehicles released before the terminal phase. This implementation keeps one impact point and spreads the sub-charges around it; a true multiple-target bus would need a different impact model.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_Cluster">
      <subDamageAmount>150</subDamageAmount>
    </payloadEffect>
    <costList>
      <DMSE_TantastenAlloy>40</DMSE_TantastenAlloy>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- ══════════════════════════════════════════════════════════════
       二、老式彈道（V2）專屬部件
       ══════════════════════════════════════════════════════════════ -->

  <!-- 阿馬托炸藥：二戰式 850 公斤填充物，簡單、穩定、爆破效果好，工業材料即可便宜量產。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_LegacyBallistic_Warhead_Amatol</defName>
    <label>Amatol warhead</label>
    <description>Eight hundred and fifty kilograms of Amatol, a Second World War blast filler: simple, stable and cheap enough to build out of industrial stock. No special effects, just a large hole.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_LegacyBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>1</explosionRadiusOffset>
    <damageAmountOffset>100</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>30</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_LoiteringMunitions</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 特里亞倫炸藥：阿馬托供應不足時的替代品，加入燃燒成分，落點周圍會起火；略貴，但沒有更準。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_LegacyBallistic_Warhead_Trialen</defName>
    <label>Trialen warhead</label>
    <description>The later Trialen filler used when supplies of Amatol ran short: it adds an incendiary component to the blast, so the impact starts fires around the crater. Slightly more expensive and no more accurate.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_LegacyBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>1.5</explosionRadiusOffset>
    <damageAmountOffset>130</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <warheadEffect Class="DMSE.WarheadEffect_Incendiary" />
    <costList>
      <Steel>25</Steel>
      <Chemfuel>45</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

</Defs>
