<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       世代化彈道部件（V2 老式／民兵三型先進）
       Generation parts for the ballistic airframes.

       三個彈道彈體（V2、現役、民兵三型）共用的 9 個部件放在
       DMSE_BallisticMissile.xml；本檔只放「某一世代專屬」的部件：
         - V2（LegacyBallistic）：阿馬托／特里亞倫炸藥，工業材料即可量產。
         - 先進（AdvancedBallistic）：低當量、星光慣性、突防誘餌、分導。
       ================================================================== -->

  <!-- ══════════════════════════════════════════════════════════════
       一、先進彈道（民兵三型）專屬部件
       ══════════════════════════════════════════════════════════════ -->

  <!-- 低當量彈頭：W78／W87 級戰略彈頭的戰術縮小版；爆炸半徑與傷害小於全當量，但便宜、安全性高。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Warhead_LowYield</defName>
    <label>low-yield warhead</label>
    <designWord>Low Yield</designWord>
    <description>A smaller strategic warhead scaled down for tactical use.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>-3</explosionRadiusOffset>
    <damageAmountOffset>-80</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>50</Steel>
      <Chemfuel>40</Chemfuel>
      <DMSE_TantastenAlloy>8</DMSE_TantastenAlloy>
    </costList>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 星光慣性導航：以星象追蹤修正陀螺漂移，散布 -4；仍是純彈道路徑，目標移動就會落空。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Guidance_Stellar</defName>
    <label>stellar-inertial guidance</label>
    <designWord>Stellar</designWord>
    <description>Inertial guidance corrected by star sightings during flight, cutting dispersion to almost nothing. It has no terminal seeker, so a moving target is still missed. Impacts scatter around the center of the target map. It does not lock onto buildings or creatures.</description>
    <category>Guidance</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <guidanceType Class="Fortified.GuidanceType_Inertial" />
    <scatterOffset>-4</scatterOffset>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentStamped>3</ComponentStamped>
    </costList>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 突防誘餌：釋放箔條、雷達誘餌與低可觀測外罩，訊號係數 0.75（更晚被偵測）。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_Penaids</defName>
    <label>penetration aids</label>
    <designWord>PenAids</designWord>
    <description>Chaff, radar decoys and a stealth shroud released with the warhead. The missile looks much smaller on the way in, so enemy radars spot it later and have less time to respond.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="Fortified.PayloadEffect_None" />
    <signatureFactor>0.75</signatureFactor>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 多彈頭（MIRV）：彈頭匯流排在抵達前 2400 ticks 放出 3 枚重返載具（DMSE_MissileBody_ReentryVehicle），
       每枚是獨立的世界航跡，各自被偵測、鎖定、攔截；全部瞄準同一目標。
       重返載具繼承母彈的戰鬥部與導引部件，效果強度以重返載具的 N=4 計。
       見 docs/MIRV分導彈頭與誘餌載荷_實作計畫.md §5、§9。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_MIRV</defName>
    <label>multiple re-entry vehicles</label>
    <designWord>MIRV</designWord>
    <description>A post-boost bus that releases three separate re-entry vehicles in mid-flight. Each one carries the missile's warhead and guidance, flies its own track and must be shot down on its own, so the enemy needs a fire control channel and an interceptor for every warhead. All three strike the same target.\n\nShooting the bus down before it releases destroys every warhead at once.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="Fortified.PayloadEffect_None" />
    <behaviors>
      <li Class="Fortified.MissileBehaviorProps_ReleaseChildren">
        <ticksBeforeArrival>2400</ticksBeforeArrival>
        <minProgress>0.25</minProgress>
        <releaseIntervalTicks>20</releaseIntervalTicks>
        <retireParent>true</retireParent>
        <children>
          <li>
            <role>Warhead</role>
            <body>DMSE_MissileBody_ReentryVehicle</body>
            <count>3</count>
            <inheritCategories>
              <li>Warhead</li>
              <li>Guidance</li>
            </inheritCategories>
          </li>
        </children>
      </li>
    </behaviors>
    <costList>
      <DMSE_TantastenAlloy>40</DMSE_TantastenAlloy>
      <ComponentSpacer>4</ComponentSpacer>
      <Steel>60</Steel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_MIRV</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 分導突防（MIRV＋誘餌）：2 枚重返載具＋3 枚重型誘餌，釋放順序打亂。誘餌模仿重返載具。
       見 docs/MIRV分導彈頭與誘餌載荷_實作計畫.md §9.3。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_MIRVDecoy</defName>
    <label>MIRV with decoys</label>
    <designWord>MIRV Decoy</designWord>
    <description>A post-boost bus that releases two re-entry vehicles mixed in with three heavy decoys, in random order. The decoys look exactly like the warheads on radar and fall all the way to the target. Both warheads carry the missile's warhead and guidance and strike the same target.\n\nShooting the missile down before release stops it from deploying its terminal payloads.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="Fortified.PayloadEffect_None" />
    <behaviors>
      <li Class="Fortified.MissileBehaviorProps_ReleaseChildren">
        <ticksBeforeArrival>2400</ticksBeforeArrival>
        <minProgress>0.25</minProgress>
        <releaseIntervalTicks>20</releaseIntervalTicks>
        <retireParent>true</retireParent>
        <children>
          <li>
            <role>Warhead</role>
            <body>DMSE_MissileBody_ReentryVehicle</body>
            <count>2</count>
            <inheritCategories>
              <li>Warhead</li>
              <li>Guidance</li>
            </inheritCategories>
          </li>
          <li>
            <role>Decoy</role>
            <body>DMSE_MissileBody_DecoyHeavy</body>
            <count>3</count>
          </li>
        </children>
      </li>
    </behaviors>
    <costList>
      <DMSE_TantastenAlloy>30</DMSE_TantastenAlloy>
      <ComponentSpacer>4</ComponentSpacer>
      <Steel>80</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_MIRV</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 誘餌彈頭（特殊載荷）：主彈頭照常飛向目標，途中放出 4 枚輕型誘餌＋1 枚重型誘餌，外觀模仿整枚導彈。
       輕型誘餌只在中段有用（再入時燒毀），重型誘餌會一路落到目標。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_AdvBallistic_Payload_Decoys</defName>
    <label>decoy warheads</label>
    <designWord>Decoy</designWord>
    <description>Releases four reflector decoys and one dummy warhead in mid-flight, each with a radar shape and infrared signature close to the missile's. The light decoys burn up on re-entry, while the heavy one joins the terminal penetration but does no actual damage.</description>
    <category>Payload</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_AdvancedBallistic</li>
    </compatibleBodies>
    <payloadEffect Class="Fortified.PayloadEffect_None" />
    <behaviors>
      <li Class="Fortified.MissileBehaviorProps_ReleaseChildren">
        <ticksBeforeArrival>2400</ticksBeforeArrival>
        <minProgress>0.25</minProgress>
        <releaseIntervalTicks>20</releaseIntervalTicks>
        <retireParent>false</retireParent>
        <children>
          <li>
            <role>Decoy</role>
            <body>DMSE_MissileBody_DecoyLight</body>
            <count>4</count>
          </li>
          <li>
            <role>Decoy</role>
            <body>DMSE_MissileBody_DecoyHeavy</body>
            <count>1</count>
          </li>
        </children>
      </li>
    </behaviors>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- ══════════════════════════════════════════════════════════════
       二、老式彈道（V2）專屬部件
       ══════════════════════════════════════════════════════════════ -->

  <!-- 阿馬托炸藥：二戰式 850 公斤填充物，簡單、穩定、爆破效果好，工業材料即可便宜量產。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_LegacyBallistic_Warhead_Amatol</defName>
    <label>Amatol warhead</label>
    <designWord>Amatol</designWord>
    <description>A large, simple warhead of amatol explosive, stable and cheap enough to make from industrial materials. It leaves a big hole and nothing more.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_LegacyBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>1</explosionRadiusOffset>
    <damageAmountOffset>100</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>30</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_LoiteringMunitions</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

  <!-- 特里亞倫炸藥：阿馬托供應不足時的替代品，加入燃燒成分，落點周圍會起火；略貴，但沒有更準。 -->
  <Fortified.MissilePartDef>
    <defName>DMSE_LegacyBallistic_Warhead_Trialen</defName>
    <label>Trialen warhead</label>
    <designWord>Trialen</designWord>
    <description>A warhead of trialen explosive with an incendiary component, so the impact starts fires around the crater. Slightly more expensive than amatol.</description>
    <category>Warhead</category>
    <compatibleBodies>
      <li>DMSE_MissileBody_LegacyBallistic</li>
    </compatibleBodies>
    <explosionRadiusOffset>1.5</explosionRadiusOffset>
    <damageAmountOffset>130</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <warheadEffect Class="Fortified.WarheadEffect_Incendiary" />
    <costList>
      <Steel>25</Steel>
      <Chemfuel>45</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>DMSE_LoiteringMunitions</li>
    </researchPrerequisites>
  </Fortified.MissilePartDef>

</Defs>
