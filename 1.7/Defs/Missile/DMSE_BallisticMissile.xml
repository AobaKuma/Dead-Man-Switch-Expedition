<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 彈道導彈 彈體 ====================
       第四階：長程、僅垂直發射、不可上重力船、無物品型態（直接在發射架上裝配）。
       payloadCapacity N=8，最強效果強度。 -->

  <!-- ==================== 彈道導彈 部件 Defs ====================
       所有部件均使用新式 Class 欄位；成本反映大型彈體的物料需求。
       本檔所有部件的 compatibleBodies 均同時列出四種同階彈道彈體：
       現役 DMSE_MissileBody_Ballistic、老式 DMSE_MissileBody_LegacyBallistic（V2）、
       先進 DMSE_MissileBody_AdvancedBallistic（民兵三型）；圓點U 2026-10-27 改為中型，改用中型部件
       ——塔式發射架與發射井可切換彈體，部件共用。 -->

  <!-- == Warhead == -->

  <!-- 熱核彈頭：超大爆炸，無特殊效果（純粹毀傷力）。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Warhead_Thermonuclear</defName>
    <label>thermonuclear warhead</label>
    <description>A thermonuclear warhead. It has no special effects. It does not need any.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <explosionRadiusOffset>5</explosionRadiusOffset>
    <damageAmountOffset>200</damageAmountOffset>
    <damageDefOverride>Bomb</damageDefOverride>
    <costList>
      <Steel>80</Steel>
      <Chemfuel>100</Chemfuel>
      <DMSE_TantastenAlloy>20</DMSE_TantastenAlloy>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 空爆戰鬥部：額外 floor(N/5)=1 次攔截擲骰 + N 半徑地面爆炸（用於反彈道攔截）。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Warhead_Airburst</defName>
    <label>airburst warhead</label>
    <description>A warhead that detonates above the target to spread fragments over a wide area. When used on an interceptor, it gets extra chances to hit in each engagement.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <warheadEffect Class="DMSE.WarheadEffect_Airburst">
      <groundDamageAmount>120</groundDamageAmount>
    </warheadEffect>
    <costList>
      <Steel>60</Steel>
      <Chemfuel>60</Chemfuel>
      <DMSE_TantastenAlloy>10</DMSE_TantastenAlloy>
    </costList>
  </DMSE.MissilePartDef>

  <!-- 集束子彈戰鬥部：Impact 時在落點四周「spawn 實體破片彈」，而不是只做多點爆炸。
       與載荷的 DMSE.PayloadEffect_Cluster 差別：破片會飛、會打到路徑上的其他人，
       並照 CE 的護甲與掩護規則結算。
       子彈數 = clusterBurstCount + payloadCapacity × countPerCapacity（上限 maxCount）。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Warhead_ClusterBomblet</defName>
    <label>cluster bomblet warhead</label>
    <description>A warhead that opens over the target and scatters many small fragmentation bomblets. Each bomblet falls on its own, spreading damage across a whole compound instead of a single point.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <warheadEffect Class="DMSE.WarheadEffect_ClusterBomblets">
      <projectile>DMSE_Bullet_AirburstFrag</projectile>
      <clusterBurstCount>6</clusterBurstCount>
      <countPerCapacity>2</countPerCapacity>
      <forceMissingRange>9</forceMissingRange>
      <maxCount>48</maxCount>
    </warheadEffect>
    <costList>
      <Steel>60</Steel>
      <Chemfuel>40</Chemfuel>
      <DMSE_TantastenAlloy>10</DMSE_TantastenAlloy>
    </costList>
    <researchPrerequisites>
      <li>DMSE_LoiteringMunitions</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- 鎢芯穿甲：貫穿厚岩頂、2 格爆炸，用於打擊地下設施。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Warhead_TungstenPenetrator</defName>
    <label>tungsten penetrator</label>
    <description>A dense tungsten rod that punches through thick roofs before detonating inside. Underground shelters offer no protection against it.</description>
    <category>Warhead</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <warheadEffect Class="DMSE.WarheadEffect_TungstenPenetrator">
      <damageAmount>200</damageAmount>
    </warheadEffect>
    <costList>
      <DMSE_TantastenAlloy>40</DMSE_TantastenAlloy>
      <Steel>30</Steel>
    </costList>
  </DMSE.MissilePartDef>

  <!-- == Guidance == -->

  <!-- 慣性：高散布，射程全開。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Guidance_Inertial</defName>
    <label>inertial guidance</label>
    <description>Basic inertial guidance. With a big enough warhead, precision hardly matters. Impacts scatter around the center of the target map. It does not lock onto buildings or creatures.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Inertial" />
    <scatterOffset>0</scatterOffset>
  </DMSE.MissilePartDef>

  <!-- 火控制導：由火控雷達網路輔助瞄準，大幅收緊散布。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Guidance_FireControl</defName>
    <label>fire-control guidance</label>
    <description>Terminal guidance assisted by the colony's fire-control radar network. It greatly tightens impact dispersion.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_FireControl" />
    <scatterOffset>-3</scatterOffset>
    <costList>
      <ComponentSpacer>3</ComponentSpacer>
      <ComponentStamped>5</ComponentStamped>
    </costList>
    <researchPrerequisites>
      <li>DMSE_FireControlNetwork</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Guidance_Laser</defName>
    <label>laser terminal seeker</label>
    <description>A semi-active laser seeker. It homes on the most recent point your colony marked on the target map with a laser target designator, and falls back to inertial guidance if there is none.</description>
    <category>Guidance</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <guidanceType Class="DMSE.GuidanceType_Laser" />
    <scatterOffset>-3</scatterOffset>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentStamped>4</ComponentStamped>
    </costList>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

  <!-- == Payload == -->

  <!-- 空酬載：僅主彈頭。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Payload_None</defName>
    <label>no payload</label>
    <description>No secondary charge. The warhead does all the work.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_None" />
  </DMSE.MissilePartDef>

  <!-- 子母彈酬載：N 半徑多個子爆炸，覆蓋廣大區域。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Payload_Cluster</defName>
    <label>cluster payload</label>
    <description>Scatters submunitions across a wide area, trading concentrated blast for coverage.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_Cluster">
      <subDamageAmount>80</subDamageAmount>
    </payloadEffect>
    <costList>
      <Steel>50</Steel>
      <Chemfuel>80</Chemfuel>
    </costList>
  </DMSE.MissilePartDef>

  <!-- 反碉堡酬載：穿透厚岩頂後在內部引爆；小半徑高穿甲爆炸，並對爆心附近建築施加額外結構傷害。
       沒有它（或鎢芯穿甲戰鬥部）的導彈打在厚岩頂上只在岩層表面引爆，導引頭也不鎖定岩頂下的目標。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Payload_BunkerBuster</defName>
    <label>bunker buster payload</label>
    <description>A hardened penetrator charge with a delayed fuze. It bores through thick rock roofs and detonates inside, wrecking nearby structures.\n\nWithout this or a penetrator warhead, a missile that hits a mountain detonates on the rock surface, and its seeker ignores targets under thick roofs.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_BunkerBuster">
      <damageAmount>220</damageAmount>
      <structureDamage>500</structureDamage>
    </payloadEffect>
    <costList>
      <Steel>60</Steel>
      <Plasteel>30</Plasteel>
    </costList>
  </DMSE.MissilePartDef>

  <!-- 反粒子酬載：N 半徑 BombSuper 爆炸，毀傷力極強。 -->
  <DMSE.MissilePartDef>
    <defName>DMSE_Ballistic_Payload_Antiparticle</defName>
    <label>antiparticle payload</label>
    <description>A secondary antiparticle burst that destroys almost everything in range. The most destructive payload available.</description>
    <category>Payload</category>
    <compatibleBodies><li>DMSE_MissileBody_AdvancedBallistic</li><li>DMSE_MissileBody_LegacyBallistic</li></compatibleBodies>
    <payloadEffect Class="DMSE.PayloadEffect_Antiparticle">
      <damageAmount>300</damageAmount>
    </payloadEffect>
    <costList>
      <DMSE_TantastenAlloy>30</DMSE_TantastenAlloy>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DMSE_StrategicSystems</li>
    </researchPrerequisites>
  </DMSE.MissilePartDef>

</Defs>
