<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       三代裝備體系的防空砲（docs/三代裝備體系_實作計畫.md §5、§11-3）
       Both guns are Building_TurretGun (ground fire) + DMSE.CompTerminalCIWS (terminal interception).
         - Flak 43（老資歷）：要砲手（CompMannable：原版 Building_TurretGun.Tick 無人不射擊，
           CompBVRDevice.Active 無人不攔截），砲彈用鋼，8 發彈夾，每輪攔截率 0.2。
         - 千禧年（小登）：全自動、3000 W，攔截率 0.85，每發 CIWS 消耗 2 發空爆彈。
       ================================================================== -->

  <!-- ==================== 老式防空砲「Flak 43」（2x2，手操）==================== -->
  <ThingDef ParentName="DMS_BaseCannonBuilding">
    <defName>DMSE_Turret_LegacyFlak</defName>
    <label>legacy flak gun</label>
    <description>A crew-served 37 mm anti-aircraft autocannon based on the 3.7 cm Flak 43. Its gas-operated action feeds from eight-round clips; a gunner turns the handwheels and aims through an optical sight. Small high-explosive shells and rapid bursts make it useful against slow, low-flying targets, but it has no radar, electrical drive or automatic fire control.\n\nNeeds a gunner. Fires steel-supplied 37 mm rounds at ground targets and at incoming missiles in their final approach. Requires Radar and gas operation research.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Building/AA_Gun/AntiAirGun_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.6,3.6)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <fillPercent>0.5</fillPercent>
    <!-- 數值對標原版自動加農炮塔（Turret_Autocannon：380 HP／15000 工作／0.96 砲塔精度）。
         手操砲折價：HP 300、工作 9000（約 6 折）。 -->
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>9000</WorkToBuild>
      <Beauty>-2</Beauty>
      <ShootingAccuracyTurret>0.85</ShootingAccuracyTurret>
    </statBases>
    <!-- 手操砲不繼承基底的休眠 Comp（與 DMS 核心的 Vasilek 等手操砲相同）。 -->
    <comps Inherit="false">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
      <!-- 37 毫米砲彈：鋼，1 鋼 = 4 發（原 8 發太便宜）；對地每發 1，CIWS 每發 1。 -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>37 mm rounds</fuelLabel>
        <fuelGizmoLabel>37 mm rounds</fuelGizmoLabel>
        <outOfFuelMessage>Cannot fire: no shells.</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>80</fuelCapacity>
        <fuelMultiplier>4</fuelMultiplier>
        <initialFuelPercent>0.5</initialFuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <autoRefuelPercent>0.5</autoRefuelPercent>
      </li>
      <li Class="DMSE.CompProperties_TerminalCIWS">
        <projectile>DMSE_Bullet_LegacyFlak_CIWS</projectile>
        <terminalWindowTicks>1800</terminalWindowTicks>
        <cooldownTicks>90</cooldownTicks>
        <ticksBetweenShots>14</ticksBetweenShots>
        <shotsPerBurst>8</shotsPerBurst>
        <interceptChance>0.2</interceptChance>
        <debrisChance>0.4</debrisChance>
        <aimLeadCells>3</aimLeadCells>
        <aimSweepCells>3</aimSweepCells>
        <fuelPerShot>1</fuelPerShot>
      </li>
    </comps>
    <building>
      <turretGunDef>DMSE_Gun_LegacyFlak</turretGunDef>
      <turretTopDrawSize>3.5</turretTopDrawSize>
      <turretBurstWarmupTime>0.5</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.2</turretBurstCooldownTime>
    </building>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <!-- 造價對標原版自動加農炮塔（350 鋼＋40 玻璃鋼＋6 零件 ≈ 430 鋼等值）的 6 折。 -->
    <costList>
      <Steel>260</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <researchPrerequisites Inherit="False">
      <li>DMSE_RadarBasis</li>
      <li>GasOperation</li>
    </researchPrerequisites>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
  </ThingDef>

