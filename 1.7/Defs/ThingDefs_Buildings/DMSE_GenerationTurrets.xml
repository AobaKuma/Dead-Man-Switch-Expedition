<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       三代裝備體系的防空砲（docs/三代裝備體系_實作計畫.md §5、§11-3）
       Both guns are Building_TurretGun (ground fire) + DMSE.CompTerminalCIWS (terminal interception).
         - Flak 43（老資歷）：要砲手（CompMannable：原版 Building_TurretGun.Tick 無人不射擊，
           CompBVRDevice.Active 無人不攔截），砲彈用鋼，8 發彈夾，每輪攔截率 0.2。
         - 千禧年（小登）：全自動、3000 W，攔截率 0.85，每發 CIWS 消耗 2 發空爆彈。
       ================================================================== -->

  <!-- ==================== 老式防空砲「Flak 43」（2x2，手操）==================== -->
  <ThingDef ParentName="DMS_BaseCannonBuilding">
    <defName>DMSE_Turret_LegacyFlak</defName>
    <label>legacy flak gun</label>
    <description>A crew-served 37 mm anti-aircraft autocannon based on the 3.7 cm Flak 43. Its gas-operated action feeds from eight-round clips; a gunner turns the handwheels and aims through an optical sight. Small high-explosive shells and rapid bursts make it useful against slow, low-flying targets, but it has no radar, electrical drive or automatic fire control.\n\nNeeds a gunner. Fires steel-supplied 37 mm rounds at ground targets and at incoming missiles in their final approach. Requires Radar and gas operation research.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Building/AA_Gun/AntiAirGun_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.6,3.6)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <fillPercent>0.5</fillPercent>
    <!-- 數值對標原版自動加農炮塔（Turret_Autocannon：380 HP／15000 工作／0.96 砲塔精度）。
         手操砲折價：HP 300、工作 9000（約 6 折）。 -->
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>9000</WorkToBuild>
      <Beauty>-2</Beauty>
      <ShootingAccuracyTurret>0.85</ShootingAccuracyTurret>
    </statBases>
    <!-- 手操砲不繼承基底的休眠 Comp（與 DMS 核心的 Vasilek 等手操砲相同）。 -->
    <comps Inherit="false">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
      <!-- 37 毫米砲彈：鋼，1 鋼 = 4 發（原 8 發太便宜）；對地每發 1，CIWS 每發 1。 -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>37 mm rounds</fuelLabel>
        <fuelGizmoLabel>37 mm rounds</fuelGizmoLabel>
        <outOfFuelMessage>Cannot fire: no shells.</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>80</fuelCapacity>
        <fuelMultiplier>4</fuelMultiplier>
        <initialFuelPercent>0.5</initialFuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <autoRefuelPercent>0.5</autoRefuelPercent>
      </li>
      <li Class="DMSE.CompProperties_TerminalCIWS">
        <projectile>DMSE_Bullet_LegacyFlak_CIWS</projectile>
        <terminalWindowTicks>1800</terminalWindowTicks>
        <cooldownTicks>90</cooldownTicks>
        <ticksBetweenShots>14</ticksBetweenShots>
        <shotsPerBurst>8</shotsPerBurst>
        <interceptChance>0.2</interceptChance>
        <debrisChance>0.4</debrisChance>
        <aimLeadCells>3</aimLeadCells>
        <aimSweepCells>3</aimSweepCells>
        <fuelPerShot>1</fuelPerShot>
      </li>
    </comps>
    <building>
      <turretGunDef>DMSE_Gun_LegacyFlak</turretGunDef>
      <turretTopDrawSize>3.5</turretTopDrawSize>
      <turretBurstWarmupTime>0.5</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.2</turretBurstCooldownTime>
    </building>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <!-- 造價對標原版自動加農炮塔（350 鋼＋40 玻璃鋼＋6 零件 ≈ 430 鋼等值）的 6 折。 -->
    <costList>
      <Steel>260</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <researchPrerequisites Inherit="False">
      <li>DMSE_RadarBasis</li>
      <li>GasOperation</li>
    </researchPrerequisites>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>DMSE_Gun_LegacyFlak</defName>
    <label>37 mm flak autocannon</label>
    <description>A crew-served, gas-operated 37 mm anti-aircraft autocannon based on the 3.7 cm Flak 43, fed from eight-round clips.</description>
    <graphicData>
      <texPath>Things/Building/AA_Gun/AntiAirGun_Turret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3</drawSize>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.6</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.6</AccuracyMedium>
      <AccuracyLong>0.5</AccuracyLong>
      <RangedWeapon_Cooldown>3.2</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>DMSE_Bullet_LegacyFlak</defaultProjectile>
        <requireLineOfSight>true</requireLineOfSight>
        <warmupTime>0.5</warmupTime>
        <!-- 高爆砲彈：原版要求爆炸投射物有 forcedMissRadius。 -->
        <forcedMissRadius>0.9</forcedMissRadius>
        <minRange>3.9</minRange>
        <range>34.9</range>
        <ai_AvoidFriendlyFireRadius>1.5</ai_AvoidFriendlyFireRadius>
        <ticksBetweenBurstShots>14</ticksBetweenBurstShots>
        <burstShotCount>8</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>DMSE_Bullet_LegacyFlak</defName>
    <label>37 mm HE round</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <explosionRadius>0.9</explosionRadius>
      <speed>85</speed>
    </projectile>
  </ThingDef>

  <!-- 末端 CIWS 曳光彈：朝天空直射的視覺彈（CompTerminalCIWS 以 ProjectileHitFlags.None 發射，不造成傷害）。 -->
  <ThingDef ParentName="BaseBullet">
    <defName>DMSE_Bullet_LegacyFlak_CIWS</defName>
    <label>37 mm tracer round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <speed>85</speed>
    </projectile>
  </ThingDef>

  <!-- ==================== 先進防空砲「千禧年」（3x3，全自動）==================== -->
  <ThingDef ParentName="DMS_BaseCannonBuilding">
    <defName>DMSE_Turret_Millennium</defName>
    <label>advanced air-defence gun</label>
    <description>A modern 35 mm anti-aircraft gun with programmable airburst ammunition, radar and electro-optical tracking and a fire-control system that engages several targets at once, its interception rate startling and so is its draw on power and ammunition, every engagement a crate of silver poured into the sky.\n\nFires airburst rounds made from steel; each terminal-defence burst burns through dozens of them.</description>
    <techLevel>Industrial</techLevel>
    <uiIconPath>Things/Turrets/DMS_Oerlikon_icon</uiIconPath>
    <uiIconScale>1.8</uiIconScale>
    <graphicData>
      <texPath>Things/Building/TurretBase/baseHeavy</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>4</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <size>(3,3)</size>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <fillPercent>0.7</fillPercent>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>15000</WorkToBuild>
      <Beauty>-2</Beauty>
      <ShootingAccuracyTurret>1</ShootingAccuracyTurret>
    </statBases>
    <comps>
      <li Class="CompProperties_Explosive">
        <wickTicks>360</wickTicks>
        <explosiveRadius>2.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <startWickHitPointsPercent>0.1</startWickHitPointsPercent>
      </li>
      <!-- 35 毫米空爆彈：鋼，1 鋼 = 3 發；對地每發 1，CIWS 每發 2（一輪 12 發 = 24）。 -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>35 mm airburst rounds</fuelLabel>
        <fuelGizmoLabel>35 mm rounds</fuelGizmoLabel>
        <outOfFuelMessage>Cannot fire: no rounds.</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>600</fuelCapacity>
        <fuelMultiplier>3</fuelMultiplier>
        <initialFuelPercent>0.5</initialFuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <autoRefuelPercent>0.5</autoRefuelPercent>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="DMSE.CompProperties_TerminalCIWS">
        <projectile>DMSE_Bullet_Vulcan_WingBack_CIWS</projectile>
        <terminalWindowTicks>1800</terminalWindowTicks>
        <cooldownTicks>30</cooldownTicks>
        <ticksBetweenShots>3</ticksBetweenShots>
        <shotsPerBurst>12</shotsPerBurst>
        <interceptChance>0.85</interceptChance>
        <debrisChance>0.2</debrisChance>
        <aimLeadCells>5</aimLeadCells>
        <aimSweepCells>7</aimSweepCells>
        <aimHeightFar>1</aimHeightFar>
        <aimHeightNear>0.45</aimHeightNear>
        <fuelPerShot>2</fuelPerShot>
      </li>
    </comps>
    <building>
      <turretGunDef>DMSE_Gun_Millennium</turretGunDef>
      <turretTopDrawSize>8</turretTopDrawSize>
      <turretBurstWarmupTime>1.5</turretBurstWarmupTime>
      <turretBurstCooldownTime>2</turretBurstCooldownTime>
    </building>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList>
      <Steel>250</Steel>
      <DMSE_TantastenAlloy>80</DMSE_TantastenAlloy>
      <ComponentIndustrial>15</ComponentIndustrial>
      <ComponentSpacer>6</ComponentSpacer>
    </costList>
    <researchPrerequisites Inherit="False">
      <li>DMSE_Aerospace</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>DMSE_Gun_Millennium</defName>
    <label>35 mm revolver cannon</label>
    <description>A 35 mm revolver cannon firing programmable airburst rounds.</description>
    <graphicData>
      <texPath>Things/Turrets/DMS_Oerlikon_Gun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>8</drawSize>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.95</AccuracyTouch>
      <AccuracyShort>0.92</AccuracyShort>
      <AccuracyMedium>0.85</AccuracyMedium>
      <AccuracyLong>0.78</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>DMSE_Bullet_Millennium</defaultProjectile>
        <requireLineOfSight>true</requireLineOfSight>
        <warmupTime>1.5</warmupTime>
        <minRange>3.9</minRange>
        <range>42.9</range>
        <ai_AvoidFriendlyFireRadius>4.9</ai_AvoidFriendlyFireRadius>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <burstShotCount>6</burstShotCount>
        <soundCast>DMS_Shot_GAU</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>DMSE_Bullet_Millennium</defName>
    <label>35 mm airburst round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.4</armorPenetrationBase>
      <stoppingPower>3</stoppingPower>
      <speed>110</speed>
    </projectile>
  </ThingDef>

</Defs>
