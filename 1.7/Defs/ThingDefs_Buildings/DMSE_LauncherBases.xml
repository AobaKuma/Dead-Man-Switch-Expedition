<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    四階導彈發射平台的共用抽象母 Def。本體在 FFF（FFF_TiltLauncherBase / FFF_VerticalLauncherBase，
    1.7/Missiles/Defs/Missile/FFF_MissileBases.xml）；這裡的 DMSE_* 只是別名，多加 DMSE 的建造分頁。
    各階導彈的實際發射架請以 ParentName 繼承下列其一，並各自補上 graphicData / size /
    costList / statBases / comps 以及一份 Fortified.MissileLauncherExtension（宣告 sizeClass / launchMode / capacity）。

    發射方式（傾斜 vs 垂直）為「純建造限制＋視覺」：
      - 垂直發射：rotatable=false（單一朝向）＋ PlaceWorker_InvalidOverSubstructure
        （原版，阻止建於重力船 substructure 地板上）。彈道導彈專用。
      - 傾斜發射：rotatable=true，可旋轉、可建於重力船。
    兩者皆不影響彈道數值。
  -->

  <!-- DMSE_TiltLauncherBase：移到 FFF（2026-11-27），這裡只留別名讓既有子 Def 與其他模組的引用不用改。 -->
  <ThingDef Name="DMSE_TiltLauncherBase" ParentName="FFF_TiltLauncherBase" Abstract="True">
    <designationCategory>DMSE_BVRCategory</designationCategory>
  </ThingDef>

  <!-- DMSE_VerticalLauncherBase：移到 FFF（2026-11-27），這裡只留別名讓既有子 Def 與其他模組的引用不用改。 -->
  <ThingDef Name="DMSE_VerticalLauncherBase" ParentName="FFF_VerticalLauncherBase" Abstract="True">
    <designationCategory>DMSE_BVRCategory</designationCategory>
  </ThingDef>

</Defs>
