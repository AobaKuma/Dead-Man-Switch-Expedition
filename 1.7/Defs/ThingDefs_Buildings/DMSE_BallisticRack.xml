<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 塔式發射架（2x2 垂直發射，老資歷）====================
       與 3x3 戰略導彈發射井同樣是「無物品型態、就地裝配」的彈道平台：
       CompMissileConfig 直接掛在建築上，WorkGiver_AssembleBallisticSilo / JobDriver_AssembleBallisticSilo
       會自動掃到本建築。

       與發射井的差異（docs/三代裝備體系_實作計畫.md §5-1、§8-2）：
         - 開放式桁架塔：已裝配完成（CompMissileLauncher_Ballistic.IsLoaded）時，
           DMSE.CompMissileBodyRenderer 會在架中央畫出直立彈體（貼圖取自該彈體的 incomingSkyfaller），
           桁架頂層（overlay）畫在彈體之上，未裝彈時只看得到空塔。
         - 沒有導流與抑爆：發射時 DMSE.CompLaunchBackblast 對半徑 3.5 格的 Pawn 造成火焰傷害與震懾、
           點燃可燃物；不傷建築（含塔本身）。
         - 預設彈體是老式彈道（V2，基本導彈工程）；圓點U、現役、民兵三型要各自的研究
           （MissileBodyDef.researchPrerequisites，ITab_MissileAssembly 的彈體選單顯示為鎖定）。
         - 不可旋轉（垂直發射唯一朝向），禁止建於重力船 substructure（繼承自 DMSE_VerticalLauncherBase）。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_BallisticRack</defName>
    <label>ballistic launch tower</label>
    <description>An old launch tower that stands a ballistic missile upright in a truss frame, simple and cheap but with no flame trench and no blast suppression, so that at ignition the exhaust and shockwave sweep outward to set nearby grass alight and injure anyone who did not walk far enough; it is good for throwing cheap airframes a long way and bad for building next to your own warehouse.\n\nThe airframe has no item form: colonists assemble it on the tower from raw materials. Swap airframes from the assembly tab; newer ones need their own research.\n\nCannot be installed on gravship decks.</description>
    <graphicData>
      <texPath>Things/Building/BallisticRack/building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/BallisticRack/icon</uiIconPath>
    <size>(3,3)</size>
    <pathCost>70</pathCost>
    <fillPercent>0.6</fillPercent>
    <staticSunShadowHeight>0.15</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Flammability>0.0</Flammability>
    </statBases>
    <!-- 發射架本身不帶彈體：建造完畢是空架，裝配完成後才畫出直立彈體。 -->
    <costList>
      <Steel>280</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentStamped>6</ComponentStamped>
    </costList>
    <comps>
      <!-- 待機功耗：架體液壓與溫控，較發射井低。 -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <!-- 彈道導彈的裝配設定（彈體 + 彈頭/導引/酬載）直接存於建築本身；預設老式彈道（V2）。 -->
      <li Class="DMSE.CompProperties_MissileConfig">
        <defaultBody>DMSE_MissileBody_LegacyBallistic</defaultBody>
      </li>
      <!-- 發射控制：在世界地圖選靶並點火；離場/落點 skyfaller 與發射井共用。 -->
      <li Class="DMSE.CompProperties_BallisticLauncher">
        <skyfaller>DMSE_Launch_AdvancedBallistic</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_AdvancedBallisticMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_BallisticMissile</worldObjectDef>
        <launchCooldownTicks>2400</launchCooldownTicks>
        <launchForwardCells>0</launchForwardCells>
      </li>
      <!-- 發射時的尾焰與衝擊波：燒傷、震懾、點火；不傷建築。 -->
      <li Class="DMSE.CompProperties_LaunchBackblast">
        <radius>9</radius>
        <damageAmount>18</damageAmount>
        <igniteChance>0.8</igniteChance>
        <stunTicks>60</stunTicks>
        <affectsBuildings>false</affectsBuildings>
        <effecter>DMS_LaunchDust_Recoilless</effecter>
      </li>
      <!-- 架上彈體渲染：桁架（overlay）永遠畫在底座之上；已裝配完成時，直立彈體疊在桁架中央 -->
      <li Class="DMSE.CompProperties_MissileBodyRenderer">
        <drawSize>(8,8)</drawSize>
        <drawOffset>(0, 0, 4.0)</drawOffset>
        <overlay>
          <texPath>Things/Building/BallisticRack/building_top</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(3,9)</drawSize>
          <drawOffset>(0,0,2.99)</drawOffset>
        </overlay>
      </li>
    </comps>
    <inspectorTabs>
      <li>DMSE.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_LoiteringMunitions</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
