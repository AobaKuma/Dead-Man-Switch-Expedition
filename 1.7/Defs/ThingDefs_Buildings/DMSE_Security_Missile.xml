<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>DMSE_Building_Scorer</defName>
        <label>cruise missile launcher</label>
        <description>A cruise missile launch system used aboard the Colonial Fleet's cruisers and armed landing ships. It is a versatile launcher.</description>
        <category>Building</category>
        <!-- 容器式裝載：彈藥以實體 Thing 存入內部容器，逐枚保留各自數值與渲染（取代舊 CompRefuelable 抽象燃料）。 -->
        <thingClass>Fortified.Building_MissileRack</thingClass>
        <graphicData>
            <texPath>Things/Building/MissileLauncher/building</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2,6)</drawSize>
            <drawOffset>(0,0.00875,0)</drawOffset>
            <drawOffsetEast>(0,0.00875,0.35)</drawOffsetEast>
            <drawOffsetWest>(0,0.00875,0.35)</drawOffsetWest>
        </graphicData>
        <rotatable>true</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>100</pathCost>
        <constructEffect>ConstructMetal</constructEffect>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <fillPercent>0.9</fillPercent>
        <designationCategory>DMSE_BVRCategory</designationCategory>
        <size>(1,5)</size>
        <staticSunShadowHeight>0.1</staticSunShadowHeight>
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <WorkToBuild>10000</WorkToBuild>
            <Flammability>0.05</Flammability>
        </statBases>
        <selectable>true</selectable>
        <costList>
            <Steel>250</Steel>
            <ComponentStamped>10</ComponentStamped>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>
        <building>
            <destroySound>BuildingDestroyed_Metal_Small</destroySound>
            <!-- 儲存設定：使小人把巡弋飛彈搬入發射平台（Building_MissileRack 為 IHaulDestination/IStoreSettingsParent）。 -->
            <maxItemsInCell>1</maxItemsInCell>
            <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
            <fixedStorageSettings>
                <filter>
                    <thingDefs>
                        <li>DMSE_Missile_Moskit</li>
                        <li>DMSE_Missile_AdvancedCruise</li>
                        <li>DMSE_Missile_Oniks</li>
                        <li>DMSE_Missile_Yj</li>
                        <li>DMSE_Missile_Tochka</li>
                    </thingDefs>
                </filter>
            </fixedStorageSettings>
            <defaultStorageSettings>
                <priority>Important</priority>
                <filter>
                    <thingDefs>
                        <li>DMSE_Missile_Moskit</li>
                        <li>DMSE_Missile_AdvancedCruise</li>
                        <li>DMSE_Missile_Oniks</li>
                        <li>DMSE_Missile_Yj</li>
                        <li>DMSE_Missile_Tochka</li>
                    </thingDefs>
                </filter>
            </defaultStorageSettings>
        </building>
        <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        <!-- 四階分類：中型階、傾斜發射、彈容 1。作為平台分類架構的具體範本。
             戰斧（DMSE_MissileBody_AdvancedCruise）已改列輕型階，艦載 Scorer 仍收：extraSizeClasses 加 Light。 -->
        <modExtensions>
            <li Class="Fortified.MissileLauncherExtension">
                <sizeClass>Medium</sizeClass>
                <extraSizeClasses>
                    <li>Light</li>
                </extraSizeClasses>
                <launchMode>Tilt</launchMode>
                <capacity>1</capacity>
            </li>
            <!-- 敵方陣地生成時自動填充：Industrial 以上派系填入巡弋導彈。 -->
            <li Class="Fortified.MissileRackAutoFillExtension">
                <enemyFactionOnly>true</enemyFactionOnly>
                <fillRules>
                    <li>
                        <minTechLevel>Industrial</minTechLevel>
                        <candidates>
                            <li>DMSE_Missile_Moskit</li>
                        </candidates>
                        <!-- fillCount=-1 = 填滿至容量上限 -->
                    </li>
                </fillRules>
            </li>
        </modExtensions>
        <comps>
            <!-- 發射：取出容器中的實體飛彈，採用其自身 CompMissileConfig（逐枚數值），以 Scorer 方式打擊地圖外目標。
                 無自身設定時回退 missileBody。已取代舊 CompMissileLauncher_Scorer + CompRefuelable。 -->
            <li Class="Fortified.CompProperties_MissileRailLauncher">
                <skyfaller>DMSE_Launch_Moskit</skyfaller>
                <skyfallerIncoming>DMSE_Incoming_Moskit</skyfallerIncoming>
                <worldObjectDef>DMSE_WorldObject_CruiseMissile</worldObjectDef>
                <missileBody>DMSE_MissileBody_Moskit</missileBody>
                <launchCooldownTicks>300</launchCooldownTicks>
                <launchForwardCells>2</launchForwardCells>
            </li>
            <!-- 發射管上層：貼圖高 2 格但占地 1 格，並排時下一座的底座會蓋住上一座的發射管；
                 把發射管（building_top_*）畫在較高的 altitude，所有發射管都在所有底座之上。 -->
            <li Class="DMSE.CompProperties_BuildingExtraRenderer">
                <extraGraphic>
                    <li>
                        <texPath>Things/Building/MissileLauncher/building_top</texPath>
                        <graphicClass>Graphic_Multi</graphicClass>
                        <drawSize>(2,6)</drawSize>
                        <drawOffset>(0,0.01875,0)</drawOffset>
                        <drawOffsetEast>(0,0.01875,0.35)</drawOffsetEast>
                        <drawOffsetWest>(0,0.01875,0.35)</drawOffsetWest>
                    </li>
                </extraGraphic>
            </li>
        </comps>
        <inspectorTabs>
            <li>RimWorld.ITab_Storage</li>
            <li>Fortified.ITab_MissileInventory</li>
            <li>Fortified.ITab_MissileAssembly</li>
        </inspectorTabs>
        <researchPrerequisites>
            <li>DMSE_IntegratedCircuits</li>
        </researchPrerequisites>
    </ThingDef>


    <WorldObjectDef>
        <defName>DMSE_WorldObject_CruiseMissile</defName>
        <label>cruise missile</label>
        <description>cruise missile in flight.</description>
        <worldObjectClass>Fortified.WorldObject_OutgoingMissile</worldObjectClass>
        <texture>UI/DMSE/TravelingMissile</texture>
        <rotateGraphicWhenTraveling>true</rotateGraphicWhenTraveling>
        <useDynamicDrawer>true</useDynamicDrawer>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>UI/DMSE/TravelingMissile_Expanding</expandingIconTexture>
        <expandingIconPriority>100</expandingIconPriority>
        <expandMore>true</expandMore>
        <allowCaravanIncidentsWhichGenerateMap>true</allowCaravanIncidentsWhichGenerateMap>
        <fullyExpandedInSpace>true</fullyExpandedInSpace>
        <validLaunchTarget>false</validLaunchTarget>
    </WorldObjectDef>

    <!-- 通用來襲導彈（任何陣營皆可發射，抵達後自動落點生成 MissileIncoming） -->
    <WorldObjectDef>
        <defName>DMSE_WorldObject_IncomingMissile</defName>
        <label>incoming missile</label>
        <description>A missile inbound to a target.</description>
        <worldObjectClass>Fortified.WorldObject_IncomingMissile</worldObjectClass>
        <texture>UI/DMSE/TravelingMissile</texture>
        <rotateGraphicWhenTraveling>true</rotateGraphicWhenTraveling>
        <useDynamicDrawer>true</useDynamicDrawer>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>UI/DMSE/TravelingMissile_Expanding</expandingIconTexture>
        <expandingIconPriority>100</expandingIconPriority>
        <expandMore>true</expandMore>
        <fullyExpandedInSpace>true</fullyExpandedInSpace>
        <validLaunchTarget>false</validLaunchTarget>
    </WorldObjectDef>


</Defs>
