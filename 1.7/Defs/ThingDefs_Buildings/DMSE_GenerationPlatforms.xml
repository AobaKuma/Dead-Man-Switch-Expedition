<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================================================================
       三代裝備體系的新平台（docs/三代裝備體系_實作計畫.md §5、§10 P2）
       New platforms of the three-generation equipment plan. 全部由既有 Comp 組成，不需新 C#：
         - 旋轉發射架（老資歷）：手操、Loitering＋Light、對地軌＋攔截兩種發射 Comp 共用一枚彈；
         - 中型傾斜發射統一使用巡弋飛彈發射器（DMSE_Building_Scorer）；
         - 野戰防空砲（中登）：全自動、彈砲一體——搜索＋2 通道火控＋4 枚攔截彈＋機砲 CIWS；
         - 搜索雷達、火控雷達（中登）；
         - 垂直發射井 2x2（小登）。
       貼圖暫借既有建築（計畫 §13-4）。
       ================================================================== -->


  <!-- ==================== 野戰防空砲（3x3，中登，彈砲一體）====================
       全自動：不掛 CompMannable，通電＋開啟即讓所有裝置運作（CompBVRDevice.Active）：
         搜索雷達（短程）＋火控雷達（2 通道）＋攔截發射器（4 枚 SA-19／刺針／攔截彈）＋機砲 CIWS（鋼製機砲彈）
         ＋本地圖對地機砲（CompBuildingTurretGun，與 CIWS 共用鋼製機砲彈；砲塔頭轉到目標方位才開火）。
       雷達開機即是反輻射導引頭的目標。貼圖借用 DMS 本體的通古斯卡（DMS_Turret_Tunguska）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>DMSE_Building_FieldAirDefense</defName>
    <label>field air-defence system</label>
    <description>A self-contained air-defense turret with twin autocannons, four short-range missiles and its own search and tracking radar. It engages targets with missiles first, then finishes them off with its guns.\n\nFully automatic. The cannons also fire on ground enemies and use steel as ammunition. The radar uses a lot of power, and its emissions can be tracked by anti-radiation missiles.</description>
    <thingClass>Building_TurretGun</thingClass>
    <category>Building</category>
    <uiIconPath>Things/Turrets/DMS_Tunguska</uiIconPath>
    <uiIconScale>1.2</uiIconScale>
    <graphicData>
      <texPath>Things/Turrets/DMS_Base_Tunguska_GateKeeper</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <!-- 建築高度 0.5 → 0.75：統一對齊 DMS_BaseCannonBuilding（掩體阻擋率 = fillPercent） -->
    <fillPercent>0.75</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>50</pathCost>
    <tickerType>Normal</tickerType>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <selectable>true</selectable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>14000</WorkToBuild>
      <Mass>400</Mass>
      <Flammability>0.25</Flammability>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>300</Steel>
      <DMSE_TantastenAlloy>40</DMSE_TantastenAlloy>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <!-- 真砲塔：對地機砲由 Building_TurretGun 自己持有（turretGunDef），不再由
           DMSE.CompBuildingTurretGun 代持。CE 下 thingClass 會被補丁換成
           Building_TurretGunCE，走的同樣是這條 turretGunDef。 -->
      <turretGunDef>DMSE_Gun_FieldAirDefense</turretGunDef>
      <turretTopDrawSize>4</turretTopDrawSize>
      <turretBurstCooldownTime>3</turretBurstCooldownTime>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_InterceptorMissile</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_InterceptorMissile</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
      <buildingTags>
        <li>DMSE_InterceptRadar</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>DMSE_FireControlNetwork</li>
    </researchPrerequisites>
    <designationCategory>DMSE_BVRCategory</designationCategory>
    <designatorDropdown>DMS_Turrets</designatorDropdown>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Tilt</launchMode>
        <capacity>4</capacity>
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>800</basePowerConsumption>
      </li>
      <!-- 全自動，不掛 CompMannable：通電＋開啟即運作（搜索雷達／火控通道／飛彈／機砲／CIWS）。
           手操只留給老式防空砲（DMSE_Turret_LegacyFlak）。
           註：CE 下機砲吃 CompAmmoUser 彈藥，而 CE 對「無人砲塔」的補彈只有相鄰
           Building_AutoloaderCE 一條路（Building_TurretGunCE.TryOrderReload 的 manning 條件
           不成立），所以 CE 環境要讓它持續開火，得在旁邊放一台自動裝彈機。 -->
      <!-- 搜索／追蹤雷達：短程、低功率，主要給自己的防空網提供航跡。 -->
      <li Class="Fortified.CompProperties_SearchRadar">
        <worldDetectionRange>4</worldDetectionRange>
        <searchDistance>100</searchDistance>
        <powerLevel>1</powerLevel>
        <antiStealthLevel>0</antiStealthLevel>
        <ticksPerDistance>8</ticksPerDistance>
      </li>
      <!-- 2 個火力通道，加入全陣營共用帳本。 -->
      <li Class="Fortified.CompProperties_FireControlRadar">
        <maxTargets>2</maxTargets>
        <powerLevel>1</powerLevel>
        <!-- 誘餌識別率（docs/MIRV分導彈頭與誘餌載荷_實作計畫.md §7.3） -->
        <decoyDiscrimination>0.1</decoyDiscrimination>
        <guidanceAccuracyTime>700</guidanceAccuracyTime>
        <maxRangeTicks>3000</maxRangeTicks>
        <minInterceptAltitude>100</minInterceptAltitude>
        <maxInterceptAltitude>20000</maxInterceptAltitude>
        <maxHitChance>0.8</maxHitChance>
        <stealthMissFactor>0.6</stealthMissFactor>
        <lockOnTicks>150</lockOnTicks>
      </li>
      <li Class="Fortified.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_Launch_LegacyInterceptor</interceptorSkyfaller>
        <reloadCooldownTicks>240</reloadCooldownTicks>
        <interceptorTravelTicks>180</interceptorTravelTicks>
      </li>
      <!-- 機砲彈：鋼，1 鋼 = 4 發；CIWS 每發消耗 1。 -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Cannon rounds</fuelLabel>
        <fuelGizmoLabel>Cannon rounds</fuelGizmoLabel>
        <outOfFuelMessage>Cannot fire the cannon: no rounds.</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>200</fuelCapacity>
        <fuelMultiplier>4</fuelMultiplier>
        <initialFuelPercent>0.5</initialFuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
        <autoRefuelPercent>0.5</autoRefuelPercent>
      </li>
      <li Class="Fortified.CompProperties_TerminalCIWS">
        <projectile>DMSE_Bullet_Vulcan_WingBack_CIWS</projectile>
        <terminalWindowTicks>1800</terminalWindowTicks>
        <cooldownTicks>60</cooldownTicks>
        <ticksBetweenShots>5</ticksBetweenShots>
        <shotsPerBurst>8</shotsPerBurst>
        <interceptChance>0.35</interceptChance>
        <debrisChance>0.3</debrisChance>
        <aimLeadCells>4</aimLeadCells>
        <aimSweepCells>5</aimSweepCells>
        <fuelPerShot>1</fuelPerShot>
      </li>
      <!-- 本地圖對地機砲改由 Building_TurretGun 持有（見 building/turretGunDef），
           所以不再需要 CompBuildingTurretGun 代持，也不再需要 CompTurretFacingRenderer
           自繪砲塔頭——TurretTop 會自己畫 DMSE_Gun_FieldAirDefense 的貼圖（同一張通古斯卡砲塔圖）。
           飛彈儲存改掛 comp：容器不再寫在建築類別上，CE 換掉 thingClass 也不會消失。 -->
      <li Class="Fortified.CompProperties_MissileRackStorage" />
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>Fortified.ITab_MissileInventory</li>
    </inspectorTabs>
    <placeWorkers>
      <li>Fortified.PlaceWorker_NoAdjacentSameLayer</li>
    </placeWorkers>
  </ThingDef>

  <!-- 野戰防空砲的對地機砲（2A38 雙聯 30 毫米）。本體不是 Building_TurretGun，此武器由 CompBuildingTurretGun 持有；
       冷卻用 verb 的 defaultCooldownTime（CompTurretGun 讀這個，不讀 RangedWeapon_Cooldown）。 -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>DMSE_Gun_FieldAirDefense</defName>
    <label>twin 30 mm cannon</label>
    <description>A pair of 30 mm automatic cannon mounted beside the missile tubes of a field air-defence system.</description>
    <graphicData>
      <texPath>Things/Turrets/DMS_Gun_Tunguska</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>DMSE_Bullet_FieldAirDefense</defaultProjectile>
        <requireLineOfSight>true</requireLineOfSight>
        <warmupTime>1</warmupTime>
        <defaultCooldownTime>3</defaultCooldownTime>
        <minRange>3.9</minRange>
        <range>39.9</range>
        <ai_AvoidFriendlyFireRadius>4.9</ai_AvoidFriendlyFireRadius>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <burstShotCount>8</burstShotCount>
        <soundCast>DMS_Shot_Tunguska</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>DMSE_Bullet_FieldAirDefense</defName>
    <label>30 mm round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <stoppingPower>2.5</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>

  <!-- ==================== 搜索雷達（3x3，中登）====================
       純搜索、2500 W、反隱身 1；不提供火力通道。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>DMSE_SearchRadar</defName>
    <label>search radar</label>
    <description>An active search radar with a rotating antenna. It finds and tracks incoming threats for the whole air-defense network, but cannot guide interceptors by itself.\n\nUses a lot of power. Its emissions can be tracked by anti-radiation missiles.</description>
    <uiIconPath>Things/Building/Icon_Radar_EW</uiIconPath>
    <graphicData>
      <texPath>Things/Building/FacilityBase_Green</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <fillPercent>0.8</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>300</Mass>
      <Flammability>0.25</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>140</Steel>
      <Tungsteel>120</Tungsteel>
      <ComponentStamped>8</ComponentStamped>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <buildingTags>
        <li>DMSE_InterceptRadar</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>DMSE_RadarNetwork</li>
    </researchPrerequisites>
    <designationCategory>DMSE_BVRCategory</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="Fortified.CompProperties_PowerThrottle" />
      <li Class="Fortified.CompProperties_SearchRadar">
        <worldDetectionRange>12</worldDetectionRange>
        <searchDistance>200</searchDistance>
        <powerLevel>1</powerLevel>
        <antiStealthLevel>1</antiStealthLevel>
        <ticksPerDistance>8</ticksPerDistance>
      </li>
      <!-- 純視覺：旋轉雷達頂部（閒置擺動調成近乎連續轉動）。 -->
      <li Class="Fortified.CompProperties_TurretFacingRenderer">
        <texPath>Things/Building/Radar_EW</texPath>
        <drawSize>(13,13)</drawSize>
        <altitudeOffset>0.01</altitudeOffset>
        <rotationSpeedDegPerTick>3</rotationSpeedDegPerTick>
        <idleTurnDegreesPerTick>1.5</idleTurnDegreesPerTick>
        <idleTurnDuration>600</idleTurnDuration>
        <idleTurnIntervalMin>1</idleTurnIntervalMin>
        <idleTurnIntervalMax>2</idleTurnIntervalMax>
      </li>
    </comps>
  </ThingDef>

  <!-- ==================== 火控雷達（3x3，中登）====================
       純火控、4 個火力通道、1500 W；自動運作（不需操作員）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>DMSE_FireControlRadar</defName>
    <label>fire control radar</label>
    <description>A dedicated fire-control radar. It turns search radar tracks into firing solutions and guides several interceptors at once, much faster and more accurately than early sets.\n\nNeeds a steady power supply. Its emissions can be tracked by anti-radiation missiles.</description>
    <uiIconPath>Things/Building/icon_Radar_FC</uiIconPath>
    <graphicData>
      <texPath>Things/Building/FacilityBase_Green</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <fillPercent>0.8</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Mass>250</Mass>
      <Flammability>0.25</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>180</Steel>
      <Tungsteel>220</Tungsteel>
      <ComponentStamped>12</ComponentStamped>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <buildingTags>
        <li>DMSE_InterceptRadar</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>DMSE_FireControlNetwork</li>
    </researchPrerequisites>
    <designationCategory>DMSE_BVRCategory</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="Fortified.CompProperties_PowerThrottle" />
      <li Class="Fortified.CompProperties_FireControlRadar">
        <maxTargets>4</maxTargets>
        <powerLevel>1</powerLevel>
        <!-- 誘餌識別率（docs/MIRV分導彈頭與誘餌載荷_實作計畫.md §7.3） -->
        <decoyDiscrimination>0.25</decoyDiscrimination>
        <guidanceAccuracyTime>700</guidanceAccuracyTime>
        <maxRangeTicks>5000</maxRangeTicks>
        <minInterceptAltitude>50</minInterceptAltitude>
        <maxInterceptAltitude>40000</maxInterceptAltitude>
        <maxHitChance>0.85</maxHitChance>
        <stealthMissFactor>0.55</stealthMissFactor>
        <lockOnTicks>150</lockOnTicks>
        <supportsArtilleryGuidance>true</supportsArtilleryGuidance>
      </li>
      <li Class="Fortified.CompProperties_TurretFacingRenderer">
        <texPath>Things/Building/Radar_FC</texPath>
        <drawSize>(4,4)</drawSize>
        <altitudeOffset>0.01</altitudeOffset>
        <rotationSpeedDegPerTick>4</rotationSpeedDegPerTick>
      </li>
    </comps>
  </ThingDef>

  <!-- ==================== 垂直發射井（2x2，四單元，小登）====================
       中型導彈（白蛉、鷹擊）四單元垂直冷發射；封閉井蓋不畫彈體。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_MediumVLS</defName>
    <label>vertical launch silo</label>
    <description>A vertical launcher with four cells for medium missiles. Each missile is pushed out of its tube before igniting, and a built-in flame trench allows repeated launches. It is costly to build.\n\nCannot be built on a gravship.</description>
    <thingClass>Fortified.Building_MissileRack</thingClass>
    <uiIconPath>Things/Building/MissileSilo_Medium/icon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/MissileSilo_Medium/building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <pathCost>70</pathCost>
    <fillPercent>0.6</fillPercent>
    <staticSunShadowHeight>0.15</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Flammability>0.0</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <DMSE_TantastenAlloy>40</DMSE_TantastenAlloy>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Oniks</li>
            <li>DMSE_Missile_Yj</li>
            <li>DMSE_Missile_Tochka</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Oniks</li>
            <li>DMSE_Missile_Yj</li>
            <li>DMSE_Missile_Tochka</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Medium</sizeClass>
        <launchMode>Vertical</launchMode>
        <capacity>4</capacity>
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Fortified.CompProperties_MissileRackRenderer">
        <maxStored>4</maxStored>
        <loadedHatchTexPaths>
          <li>Things/Building/MissileSilo_Medium/hatch_a</li>
          <li>Things/Building/MissileSilo_Medium/hatch_b</li>
          <li>Things/Building/MissileSilo_Medium/hatch_c</li>
