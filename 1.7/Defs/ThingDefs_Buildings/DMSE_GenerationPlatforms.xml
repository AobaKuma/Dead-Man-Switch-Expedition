  <!-- ==================== 地面垂直發射架（4x4，四單元，大登）====================
       中型導彈（白蛉、鷹擊、圓點）四聯裝豎立發射箱，裝在地面的豎立架上：不必挖井，
       研究與材料門檻比垂直發射井低，但佔地大、較不耐打。
       唯一可旋轉的垂直發射器（覆寫母 Def 的 rotatable=false）：Graphic_Multi，西向由東向鏡像。
       需要 FFF 2026-11-27 之後的版本——井蓋疊圖跟建築貼圖同步（方向貼圖不旋轉），
       垂直發射一律朝北升空（MissileRackUtility.LaunchRotationOf）；舊版 FFF 旋轉後井蓋會錯位、導彈橫向升空。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_MediumSurfaceVLS</defName>
    <rotatable>true</rotatable>
    <label>surface vertical launcher</label>
    <description>A four-cell launcher for medium missiles, standing upright on a ground frame instead of sitting in a dug silo. It needs less research and fewer advanced materials than a vertical launch silo, but takes up far more room and is easier to damage.\n\nCannot be built on a gravship.</description>
    <thingClass>Fortified.Building_MissileRack</thingClass>
    <uiIconPath>Things/Building/MissileSilo_Medium_Surface/icon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/MissileSilo_Medium_Surface/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(7,7)</drawSize>
      <drawOffset>(0,0,1)</drawOffset>
    </graphicData>
    <size>(4,4)</size>
    <pathCost>80</pathCost>
    <fillPercent>0.75</fillPercent>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0.0</Flammability>
    </statBases>
    <costList>
      <Steel>320</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Oniks</li>
            <li>DMSE_Missile_Yj</li>
            <li>DMSE_Missile_Tochka</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Oniks</li>
            <li>DMSE_Missile_Yj</li>
            <li>DMSE_Missile_Tochka</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Medium</sizeClass>
        <launchMode>Vertical</launchMode>
        <capacity>4</capacity>
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>450</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Fortified.CompProperties_MissileRackRenderer">
        <maxStored>4</maxStored>
        <slotOffsets>
          <li>(0, 0, 1)</li>
          <li>(0, 0, 1)</li>
          <li>(0, 0, 1)</li>
          <li>(0, 0, 1)</li>
        </slotOffsets>
        <loadedHatchTexPaths>
          <li>Things/Building/MissileSilo_Medium_Surface/hatch_a</li>
          <li>Things/Building/MissileSilo_Medium_Surface/hatch_b</li>
          <li>Things/Building/MissileSilo_Medium_Surface/hatch_c</li>
          <li>Things/Building/MissileSilo_Medium_Surface/hatch_d</li>
        </loadedHatchTexPaths>
      </li>
      <li Class="Fortified.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_Launch_Yj</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_Yj</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_CruiseMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Yj</missileBody>
        <launchCooldownTicks>600</launchCooldownTicks>
        <launchForwardCells>0</launchForwardCells>
