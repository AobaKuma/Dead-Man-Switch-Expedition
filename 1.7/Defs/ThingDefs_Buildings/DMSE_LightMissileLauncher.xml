<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 輕型導彈 落點 incoming skyfaller ==================== -->
  <ThingDef ParentName="DMSE_MissileIncomingProjectileBase">
    <defName>DMSE_Incoming_LightMissile</defName>
    <label>light missile (incoming)</label>
    <thingClass>Fortified.Projectile_MissileIncoming</thingClass>
    <graphicData>
      <texPath>Things/Missile/Grison/skyFaller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.49</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <!-- BVR 特性：輕型導彈比巡航快，但比彈道慢；隱身適中。 -->
    <modExtensions>
      <li Class="Fortified.MissileFlightExtension">
        <shadowSize>(2, 2)</shadowSize>
        <rotateGraphicTowardsDirection>true</rotateGraphicTowardsDirection>
        <speed>1</speed>
      </li>
      <li Class="Fortified.AirTargetExtension">
        <distanceLevel>1.2</distanceLevel>
        <stealthLevel>0</stealthLevel>
        <speed>22</speed>
        <!-- 基準高度：既有彈種維持中性（1000 = 係數 1），高度差異留給世代化彈體。 -->
        <altitude>1000</altitude>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ==================== 輕型導彈 世界旅行物件 ==================== -->
  <WorldObjectDef>
    <defName>DMSE_WorldObject_LightMissile</defName>
    <label>light missile</label>
    <description>A light missile in flight.</description>
    <worldObjectClass>Fortified.WorldObject_OutgoingMissile</worldObjectClass>
    <texture>UI/DMSE/TravelingMissile</texture>
    <rotateGraphicWhenTraveling>true</rotateGraphicWhenTraveling>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>UI/DMSE/TravelingMissile_Expanding</expandingIconTexture>
    <expandingIconPriority>100</expandingIconPriority>
    <expandMore>true</expandMore>
    <allowCaravanIncidentsWhichGenerateMap>true</allowCaravanIncidentsWhichGenerateMap>
    <fullyExpandedInSpace>true</fullyExpandedInSpace>
    <validLaunchTarget>false</validLaunchTarget>
  </WorldObjectDef>

  <!-- ==================== 傾斜發射箱（1x3，中登）====================
       參考 DMSE_Building_LoiteringLauncher 結構，提升成本以反映更高技術層次。
       容量 4 枚輕型導彈，需 DMSE_IntegratedCircuits 解鎖。對地發射軌與 SAM 共用彈艙：
       用途過濾（MissileRoleExtension）讓攔截彈只被 SAM 取用、對地彈只被對地發射。 -->
  <ThingDef ParentName="DMSE_TiltLauncherBase">
    <defName>DMSE_Building_LightMissileLauncher</defName>
    <label>tilt-launch container</label>
    <description>An angled launch box that holds four light missiles. It loads and fires on its own, giving a solid salvo from a small footprint.\n\nRequires power. Strike missiles are launched at targets beyond the map. Surface-to-air and dual-role missiles are also fired by the fire-control network as interceptors.</description>
    <thingClass>Fortified.Building_MissileRack</thingClass>
    <graphicData>
      <texPath>Things/Building/MissileLauncher4X/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
    </graphicData>
    <size>(1,3)</size>
    <pathCost>80</pathCost>
    <fillPercent>0.55</fillPercent>
    <staticSunShadowHeight>0.1</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>7000</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Tilt</launchMode>
        <capacity>4</capacity>
      </li>
      <!-- 敵方陣地生成時自動填充：Industrial 以上派系填入攔截彈。 -->
      <li Class="Fortified.MissileRackAutoFillExtension">
        <enemyFactionOnly>true</enemyFactionOnly>
        <fillRules>
          <li>
            <minTechLevel>Industrial</minTechLevel>
            <!-- 存放過濾不含攔截彈（原本只列 DMSE_InterceptorMissile → 候選池永遠為空、敵方發射架生成時是空的）。
                 改填 DMSE_Missile_Grison（兩用）與 DMSE_Missile_Maverick（對地）。 -->
            <candidates>
              <li>DMSE_Missile_Grison</li>
              <li>DMSE_Missile_Maverick</li>
            </candidates>
          </li>
        </fillRules>
      </li>
    </modExtensions>
    <comps>
      <!-- <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li> -->
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Fortified.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_Launch_Light</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_LightMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_LightMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Light</missileBody>
        <launchCooldownTicks>450</launchCooldownTicks>
        <launchForwardCells>2</launchForwardCells>
      </li>
      <li Class="Fortified.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_Launch_LegacyInterceptor</interceptorSkyfaller>
        <reloadCooldownTicks>240</reloadCooldownTicks>
        <interceptorTravelTicks>300</interceptorTravelTicks>
      </li>
      <li Class="DMSE.CompProperties_BuildingExtraRenderer">
        <extraGraphic>
          <li>
            <texPath>Things/Building/MissileLauncher4X/building_top</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(4,5)</drawSize>
            <drawOffset>(0,0.05,0)</drawOffset>
          </li>
        </extraGraphic>
      </li>
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>Fortified.ITab_MissileInventory</li>
      <li>Fortified.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ==================== 小型垂直發射井（1x1，四單元，小登）====================
       單格四單元 VLS，適合密集部署或空間受限場合；垂直發射一律吃電（200 W）。
       不可旋轉（垂直朝向），禁止建於重力船 substructure。需 DMSE_IntegratedCircuits。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_LightMissileVLS</defName>
    <label>light vertical launch cell</label>
    <description>A ground-level vertical launcher with four cells for light missiles. It fits on a single tile, so it is easy to place along a perimeter, but each cell must be loaded separately.\n\nCannot be built on a gravship.</description>
    <thingClass>Fortified.Building_MissileRack</thingClass>
    <uiIconPath>Things/Building/MissileSilo_Small/icon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/MissileSilo_Small/building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <pathCost>60</pathCost>
    <fillPercent>0.8</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Vertical</launchMode>
        <capacity>4</capacity>
        <!-- 封閉井蓋：不畫彈體 -->
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="Fortified.CompProperties_MissileRackRenderer">
        <maxStored>4</maxStored>
        <loadedHatchTexPaths>
          <li>Things/Building/MissileSilo_Small/hatch_a</li>
          <li>Things/Building/MissileSilo_Small/hatch_b</li>
          <li>Things/Building/MissileSilo_Small/hatch_c</li>
          <li>Things/Building/MissileSilo_Small/hatch_d</li>
        </loadedHatchTexPaths>
      </li>
      <li Class="Fortified.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_Launch_Light</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_LightMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_LightMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Light</missileBody>
        <launchCooldownTicks>450</launchCooldownTicks>
        <launchForwardCells>1</launchForwardCells>
      </li>
      <!-- 垂直發射的攔截彈：攔截／兩用彈由火控雷達指派。 -->
      <li Class="Fortified.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_Launch_LegacyInterceptor</interceptorSkyfaller>
        <reloadCooldownTicks>240</reloadCooldownTicks>
        <interceptorTravelTicks>300</interceptorTravelTicks>
      </li>
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>Fortified.ITab_MissileInventory</li>
      <li>Fortified.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ==================== 非直視發射箱（2x2，十五單元，大登）====================
       4x4 發射格陣列，其中一格是控制單元，實際裝 15 枚輕型導彈。容量由
       MissileLauncherExtension.capacity 決定（容器制，與格數 maxItemsInCell 無關）。
       井蓋疊圖 hatch_a..o 依裝填順序逐格顯示。需積體電路 + 火控網路。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_NLOSLauncher</defName>
    <label>NLOS launch box</label>
    <description>A boxed vertical launcher packing fifteen light missiles into a small footprint, with one cell given over to its fire-control unit. It can empty a large salvo at targets far beyond line of sight, but takes a long time to reload by hand.\n\nCannot be built on a gravship.</description>
    <thingClass>Fortified.Building_MissileRack</thingClass>
    <uiIconPath>Things/Building/MissileSilo_NLOS/icon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/MissileSilo_NLOS/building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <pathCost>70</pathCost>
    <fillPercent>0.7</fillPercent>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>14000</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      <Steel>300</Steel>
      <DMSE_TantastenAlloy>20</DMSE_TantastenAlloy>
      <ComponentIndustrial>14</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="Fortified.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Vertical</launchMode>
        <capacity>15</capacity>
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Fortified.CompProperties_MissileRackRenderer">
        <maxStored>15</maxStored>
        <loadedHatchTexPaths>
          <li>Things/Building/MissileSilo_NLOS/hatch_a</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_b</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_c</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_d</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_e</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_f</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_g</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_h</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_i</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_j</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_k</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_l</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_m</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_n</li>
          <li>Things/Building/MissileSilo_NLOS/hatch_o</li>
        </loadedHatchTexPaths>
      </li>
      <li Class="Fortified.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_Launch_Light</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_LightMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_LightMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Light</missileBody>
        <launchCooldownTicks>300</launchCooldownTicks>
        <launchForwardCells>1</launchForwardCells>
      </li>
      <!-- 垂直發射的攔截彈：攔截／兩用彈由火控雷達指派。 -->
      <li Class="Fortified.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_Launch_LegacyInterceptor</interceptorSkyfaller>
        <reloadCooldownTicks>180</reloadCooldownTicks>
        <interceptorTravelTicks>300</interceptorTravelTicks>
      </li>
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>Fortified.ITab_MissileInventory</li>
      <li>Fortified.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
      <li>DMSE_FireControlNetwork</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
