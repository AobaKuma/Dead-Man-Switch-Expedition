<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==================== 輕型導彈 離場 skyfaller ==================== -->
  <ThingDef ParentName="SkyfallerBase">
    <defName>DMSE_SkyFaller_LightMissile</defName>
    <label>light missile (leaving)</label>
    <thingClass>DMSE.ScorerProjectile</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Missile/Grison/skyFaller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.49</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Accelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(1.5, 1.5)</shadowSize>
      <ticksToDiscardInReverse>300</ticksToDiscardInReverse>
      <ticksToImpactRange>0</ticksToImpactRange>
      <anticipationSound>DropPod_Leaving</anticipationSound>
      <anticipationSoundTicks>-1</anticipationSoundTicks>
      <speedCurve>
        <points>
          <li>(0,0.3)</li>
          <li>(0.2,0.2)</li>
          <li>(0.5,0.5)</li>
          <li>(1,1)</li>
        </points>
      </speedCurve>
      <rotationCurve>
        <points>
          <li>(0,-10)</li>
          <li>(0.30,-25)</li>
          <li>(0.6,-5)</li>
          <li>(1,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.05,2)</li>
          <li>(0.3,1)</li>
          <li>(1,10)</li>
        </points>
      </zPositionCurve>
    </skyfaller>
    <comps>
      <li Class="DMSE.CompProperties_EffecterHotLaunch">
        <launchBlastScale>0.85</launchBlastScale>
        <ignitionSound>DMSE_Missile_Flight</ignitionSound>
        <ExhaustFleck>DMS_Fleck_RocketFlame</ExhaustFleck>
        <ExhaustCurve>
          <points>
            <li>(0,2)</li>
            <li>(0.1,6)</li>
            <li>(0.5,4)</li>
            <li>(0.9,2)</li>
          </points>
        </ExhaustCurve>
        <SmokeFleck>Smoke</SmokeFleck>
        <SmokeCurve>
          <points>
            <li>(0,4)</li>
            <li>(0.5,3)</li>
            <li>(1,1)</li>
          </points>
        </SmokeCurve>
        <launchEffectTrigger>DMS_LaunchDust_Recoilless</launchEffectTrigger>
      </li>
    </comps>
  </ThingDef>

  <!-- ==================== 輕型導彈 落點 incoming skyfaller ==================== -->
  <ThingDef ParentName="DMSE_MissileIncomingProjectileBase">
    <defName>DMSE_Incoming_LightMissile</defName>
    <label>light missile (incoming)</label>
    <thingClass>DMSE.Projectile_MissileIncoming</thingClass>
    <graphicData>
      <texPath>Things/Missile/Grison/skyFaller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.49</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <!-- BVR 特性：輕型導彈比巡航快，但比彈道慢；隱身適中。 -->
    <modExtensions>
      <li Class="DMSE.MissileFlightExtension">
        <shadowSize>(2, 2)</shadowSize>
        <rotateGraphicTowardsDirection>true</rotateGraphicTowardsDirection>
        <speed>1</speed>
      </li>
      <li Class="DMSE.BVRTargetProps">
        <distanceLevel>1.2</distanceLevel>
        <stealthLevel>0</stealthLevel>
        <speed>22</speed>
        <!-- 基準高度：既有彈種維持中性（1000 = 係數 1），高度差異留給世代化彈體。 -->
        <altitude>1000</altitude>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ==================== 輕型導彈 世界旅行物件 ==================== -->
  <WorldObjectDef>
    <defName>DMSE_WorldObject_LightMissile</defName>
    <label>light missile</label>
    <description>A light missile in flight.</description>
    <worldObjectClass>DMSE.ScorerProjectile_WorldObject</worldObjectClass>
    <texture>UI/DMSE/TravelingMissile</texture>
    <rotateGraphicWhenTraveling>true</rotateGraphicWhenTraveling>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>UI/DMSE/TravelingMissile_Expanding</expandingIconTexture>
    <expandingIconPriority>100</expandingIconPriority>
    <expandMore>true</expandMore>
    <allowCaravanIncidentsWhichGenerateMap>true</allowCaravanIncidentsWhichGenerateMap>
    <fullyExpandedInSpace>true</fullyExpandedInSpace>
    <validLaunchTarget>false</validLaunchTarget>
  </WorldObjectDef>

  <!-- ==================== 傾斜發射箱（1x3，中登）====================
       參考 DMSE_Building_LoiteringLauncher 結構，提升成本以反映更高技術層次。
       容量 4 枚輕型導彈，需 DMSE_Ballistics 解鎖。對地發射軌與 SAM 共用彈艙：
       用途過濾（MissileRoleExtension）讓攔截彈只被 SAM 取用、對地彈只被對地發射。 -->
  <ThingDef ParentName="DMSE_TiltLauncherBase">
    <defName>DMSE_Building_LightMissileLauncher</defName>
    <label>tilt-launch container</label>
    <description>A tilt-launch box holding four light missiles whose lid doubles as the launch rail, loading and firing automatically at the cost of hydraulics and power while four cells share one box to give decent salvo weight in a small footprint.\n\nStrike missiles are launched at targets beyond the local map; surface-to-air and dual-role missiles are also fired by the fire-control network as interceptors.</description>
    <thingClass>DMSE.Building_MissileRack</thingClass>
    <graphicData>
      <texPath>Things/Building/MissileLauncher4X/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
    </graphicData>
    <size>(1,3)</size>
    <pathCost>80</pathCost>
    <fillPercent>0.55</fillPercent>
    <staticSunShadowHeight>0.1</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>7000</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="DMSE.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Tilt</launchMode>
        <capacity>4</capacity>
      </li>
      <!-- 敵方陣地生成時自動填充：Industrial 以上派系填入攔截彈。 -->
      <li Class="DMSE.MissileRackAutoFillExtension">
        <enemyFactionOnly>true</enemyFactionOnly>
        <fillRules>
          <li>
            <minTechLevel>Industrial</minTechLevel>
            <candidates>
              <li>DMSE_InterceptorMissile</li>
            </candidates>
          </li>
        </fillRules>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="DMSE.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_SkyFaller_LightMissile</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_LightMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_LightMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Light</missileBody>
        <launchCooldownTicks>450</launchCooldownTicks>
        <launchForwardCells>2</launchForwardCells>
      </li>
      <li Class="DMSE.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_SkyFaller_Interceptor</interceptorSkyfaller>
        <reloadCooldownTicks>240</reloadCooldownTicks>
        <interceptorTravelTicks>300</interceptorTravelTicks>
      </li>
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>DMSE.ITab_MissileInventory</li>
      <li>DMSE.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_Ballistics</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ==================== 小型垂直發射井（1x1，四單元，小登）====================
       單格四單元 VLS，適合密集部署或空間受限場合；垂直發射一律吃電（200 W）。
       不可旋轉（垂直朝向），禁止建於重力船 substructure。需 DMSE_IntegratedCircuits。 -->
  <ThingDef ParentName="DMSE_VerticalLauncherBase">
    <defName>DMSE_Building_LightMissileVLS</defName>
    <label>light vertical launch cell</label>
    <description>A 1x1 vertical launcher with four cells flush with the ground and sized only for light missiles, compact enough to ring a base's perimeter at the cost of loading each cell separately, with every opening hatch telling the enemy that something is here.\n\nCannot be installed on gravship decks.</description>
    <thingClass>DMSE.Building_MissileRack</thingClass>
    <uiIconPath>Things/Building/MissileSilo_Small/icon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/MissileSilo_Small/building</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <pathCost>60</pathCost>
    <fillPercent>0.8</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>DMSE_Missile_Grison</li>
            <li>DMSE_Missile_AdvancedLight</li>
            <li>DMSE_Missile_AdvancedCruise</li>
            <li>DMSE_Missile_Stinger</li>
            <li>DMSE_Missile_Maverick</li>
            <li>DMSE_Missile_Sparrow</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="DMSE.MissileLauncherExtension">
        <sizeClass>Light</sizeClass>
        <launchMode>Vertical</launchMode>
        <capacity>4</capacity>
        <!-- 封閉井蓋：不畫彈體 -->
        <renderStoredBody>false</renderStoredBody>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="DMSE.CompProperties_MissileRackRenderer">
        <maxStored>4</maxStored>
        <loadedHatchTexPaths>
          <li>Things/Building/MissileSilo_Small/hatch_a</li>
          <li>Things/Building/MissileSilo_Small/hatch_b</li>
          <li>Things/Building/MissileSilo_Small/hatch_c</li>
          <li>Things/Building/MissileSilo_Small/hatch_d</li>
        </loadedHatchTexPaths>
      </li>
      <li Class="DMSE.CompProperties_MissileRailLauncher">
        <skyfaller>DMSE_SkyFaller_LightMissile</skyfaller>
        <skyfallerIncoming>DMSE_Incoming_LightMissile</skyfallerIncoming>
        <worldObjectDef>DMSE_WorldObject_LightMissile</worldObjectDef>
        <missileBody>DMSE_MissileBody_Light</missileBody>
        <launchCooldownTicks>450</launchCooldownTicks>
        <launchForwardCells>1</launchForwardCells>
      </li>
      <!-- 垂直發射的攔截彈：攔截／兩用彈由火控雷達指派。 -->
      <li Class="DMSE.CompProperties_MissileLauncher">
        <interceptorSkyfaller>DMSE_SkyFaller_Interceptor</interceptorSkyfaller>
        <reloadCooldownTicks>240</reloadCooldownTicks>
        <interceptorTravelTicks>300</interceptorTravelTicks>
      </li>
    </comps>
    <inspectorTabs>
      <li>RimWorld.ITab_Storage</li>
      <li>DMSE.ITab_MissileInventory</li>
      <li>DMSE.ITab_MissileAssembly</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>DMSE_IntegratedCircuits</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
