<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DMSE_AcousticEarlyWarningRadar</defName>
    <label>passive acoustic radar</label>
    <!-- 老資歷：一座雷達時代之前的混凝土聲學反射鏡，不用電、不發射電磁波、免疫反輻射；探測距離短、對隱身與高速目標幾乎全盲。 -->
    <description>A concrete acoustic mirror that listens for distant engine noise. It needs no power and emits nothing, so anti-radiation missiles cannot find it. Its warnings come early but are vague, and it struggles to hear fast or stealthy targets.\n\nDetects incoming threats only, and cannot guide interceptors.</description>
    <graphicData>
      <texPath>Things/Building/AcousticMirror/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(8,5)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <fillPercent>0.8</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>300</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <size>(5,3)</size>
    <costStuffCount>750</costStuffCount>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costList>
      <BlocksGranite>500</BlocksGranite>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <buildingTags>
        <li>DMSE_InterceptRadar</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>DMSE_RadarBasis</li>
    </researchPrerequisites>
    <designationCategory>DMS_Category</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Flickable" />
      <!-- 不用電：純混凝土反射鏡與聽音員，沒有 CompPowerTrader（CompBVRDevice.Active 對無電力 Comp 的建築不檢查電力）。 -->
      <!-- 早期預警：只提供搜索/預警窗口，不具備火控鎖定能力（無 CompProperties_FireControlRadar）。 -->
      <li Class="DMSE.CompProperties_SearchRadar">
        <worldDetectionRange>8</worldDetectionRange>
        <searchDistance>120</searchDistance>
        <powerLevel>1</powerLevel>
        <antiStealthLevel>0</antiStealthLevel>
        <ticksPerDistance>10</ticksPerDistance>
        <!-- 核心需求：全程被動聆聽、不主動發射電磁波，故不受反輻射導引頭的目標選擇影響。 -->
        <immuneToAntiRadiationSeeker>true</immuneToAntiRadiationSeeker>
      </li>
    </comps>
    <placeWorkers>
      <li>DMSE.PlaceWorker_NoAdjacentSameLayer</li>
    </placeWorkers>
  </ThingDef>

</Defs>
