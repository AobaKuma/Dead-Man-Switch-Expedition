<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ══════════════════════════════════════════════════════════════
       海上發射站（2026-11-23，2026-11-24 改用 LaunchSite_Ocean.xml 的海上平台）：武裝殖民艦隊（DMS_Army）在近海部署的導彈陣地。
       ‧ 地圖：海上平台地圖（DMSE_SeaPlatform.xml 的高空 + 海面背景），沒有原版地形步驟、霧與玩家起點。
       ‧ 布局（DMSE.GenStep_SeaLaunchSite）：中央搜索雷達，外圈 2～4 座發射平台（DMSE_Platform_A／B／C，自帶甲板形狀、
         彈架、火控雷達、戰情室、居住艙與一根支柱），再補野戰陣地的火控雷達與近防。
         平台照自己的甲板形狀生成（含地板、屋頂）；其他野戰結構底下鋪一塊外擴 deckMargin 格的甲板。
         結構之間以 3 格寬的甲板走道連通（道路步驟 openTerrain = 高空，走道接在平台甲板的邊上），
         最後由 DMSE.GenStep_SeaLaunchSitePillars 補上支柱，撐住平台自帶支柱範圍以外的甲板。
       ‧ 支柱是可以打的弱點：支柱被毀後撐不住的甲板 15 秒後連同上面的雷達與發射架塌進海裡。
       ‧ 彈種：殖民艦隊是太空等級，彈架裝先進通用導彈、先進巡航導彈與縞瑪瑙；世界層齊射以先進通用導彈為基本彈，
         目標防空越強越常混入匿蹤巡航彈與縞瑪瑙。
       ‧ 進出：站點在水域 tile 上，遠行隊到不了（也沒有「重組遠行隊」）；只能用運輸艙、穿梭機或重力船登陸與撤離。
       ‧ 摧毀條件、補給、彈架與砲塔彈藥規則同野戰陣地（MapComponent_MissileBase）。
       ══════════════════════════════════════════════════════════════ -->

  <!-- 整張鋪高空；不放玩家的起始平台與支柱 -->
  <GenStepDef>
    <defName>DMSE_SeaLaunchSite_GS_Ocean</defName>
    <order>200</order>
    <genStep Class="Fortified.GenStep_SeaPlatform">
      <platformSize>(0,0)</platformSize>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>DMSE_SeaLaunchSite_GS_Structures</defName>
    <order>400</order>
    <genStep Class="Fortified.GenStep_SeaLaunchSite">
      <!-- 海上沒有自然地形可保留：完整生成結構（地板、屋頂），甲板由 PrepareGround 先鋪好 -->
      <keepNaturalTerrain>false</keepNaturalTerrain>
      <deckMargin>2</deckMargin>
      <centerJitter>4</centerJitter>
      <difficultyThresholds>
        <li>0.5</li>
        <li>0.9</li>
        <li>1.4</li>
      </difficultyThresholds>
      <!-- 發射平台很大（31×29、69×19、37×36），排在中央雷達之後先放，小結構再補空隙。
           半徑與數量以 200～250 格地圖模擬過：最高難度 4 座約 99% 放得下；150 格的小圖放不下的會跳過。 -->
      <groups>
        <li>
          <label>search radar</label>
          <pool>
            <li>DMSE_Mid_SearchRadar</li>
          </pool>
          <countByTier>
            <li>1</li>
          </countByTier>
          <radius>0~10</radius>
          <randomRotation>false</randomRotation>
        </li>
        <li>
          <!-- 三種平台都帶世界選靶發射器（A 輕型發射箱／垂直發射單元、B 中型垂直發射單元、C 輕型垂直發射單元），不需要 firstPool -->
          <label>launch platform</label>
          <pool>
            <li>DMSE_Platform_A</li>
            <li>DMSE_Platform_B</li>
            <li>DMSE_Platform_C</li>
          </pool>
          <countByTier>
            <li>2</li>
            <li>2~3</li>
            <li>3</li>
            <li>3~4</li>
          </countByTier>
          <radius>36~62</radius>
          <spacing>15</spacing>
        </li>
        <li>
          <!-- 平台已各帶火控／相控陣雷達，這裡只補中央雷達旁的通道 -->
          <label>fire control radar</label>
          <pool>
            <li>DMSE_Mid_FireControlRadar</li>
          </pool>
          <countByTier>
            <li>0</li>
            <li>1</li>
            <li>1</li>
            <li>2</li>
          </countByTier>
          <radius>14~30</radius>
          <spacing>5</spacing>
        </li>
        <li>
          <label>CIWS</label>
          <pool>
            <li>DMSE_Mid_CIWS</li>
          </pool>
          <countByTier>
            <li>1</li>
            <li>1~2</li>
            <li>2</li>
            <li>2~3</li>
          </countByTier>
          <radius>16~40</radius>
          <spacing>5</spacing>
        </li>
      </groups>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>DMSE_SeaLaunchSite_GS_SpawnCrew</defName>
    <order>450</order>
    <genStep Class="Fortified.GenStep_FieldLaunchSiteCrew">
      <pointsPerPawn>110</pointsPerPawn>
      <minCrew>4</minCrew>
      <maxCrew>16</maxCrew>
      <crewByTier>
        <li>4~6</li>
        <li>6~9</li>
        <li>8~12</li>
        <li>11~16</li>
      </crewByTier>
      <gunnerFraction>0.3</gunnerFraction>
      <spawnRadius>14</spawnRadius>
    </genStep>
  </GenStepDef>

  <!-- 甲板走道：道路步驟把高空當成可通行，鋪上的「路面」就是海上平台。不通往地圖邊緣（外面只有海）。
       這張圖沒有原版遺跡與地標，所以不用等到 800；走道與支柱排在守軍（450）之前，支柱才不會蓋在人身上。 -->
  <GenStepDef>
    <defName>DMSE_SeaLaunchSite_GS_Walkways</defName>
    <order>430</order>
    <genStep Class="Fortified.GenStep_FieldLaunchSiteRoads">
      <roadTerrain>DMSE_SeaPlatform</roadTerrain>
      <openTerrain>FFF_OpenAir</openTerrain>
      <roadWidth>3</roadWidth>
      <roadToMapEdge>false</roadToMapEdge>
    </genStep>
  </GenStepDef>

  <!-- 支柱：在走道之後，甲板形狀已經定了 -->
  <GenStepDef>
    <defName>DMSE_SeaLaunchSite_GS_Pillars</defName>
    <order>440</order>
    <genStep Class="Fortified.GenStep_SeaLaunchSitePillars">
      <pillarDef>DMSE_SeaPlatformPillar</pillarDef>
    </genStep>
  </GenStepDef>

  <MapGeneratorDef>
    <defName>DMSE_SeaLaunchSite_MapGen</defName>
    <label>sea launch station</label>
    <genSteps>
      <li>DMSE_SeaLaunchSite_GS_Ocean</li>
      <li>DMSE_SeaLaunchSite_GS_Structures</li>
      <li>DMSE_FieldLaunchSite_GS_RackFill</li>
      <li>DMSE_SeaLaunchSite_GS_SpawnCrew</li>
      <li>DMSE_SeaLaunchSite_GS_Walkways</li>
      <li>DMSE_SeaLaunchSite_GS_Pillars</li>
    </genSteps>
    <modExtensions>
      <li Class="Fortified.SeaPlatformMapExtension">
        <voidTerrain>FFF_OpenAir</voidTerrain>
        <deckTerrain>DMSE_SeaPlatform</deckTerrain>
        <seaDrop>14.1</seaDrop>
      </li>
    </modExtensions>
  </MapGeneratorDef>

  <WorldObjectDef>
    <defName>DMSE_SeaLaunchSite</defName>
    <label>sea launch station</label>
    <description>An offshore missile station of the armed colonial fleet, built on sea platforms raised above the waves on steel pillars: radars and launch platforms armed with advanced missiles, joined by deck walkways. It can only be reached by air. Knocking out its pillars sends the decks they hold up into the sea.</description>
    <worldObjectClass>RimWorld.Planet.Site</worldObjectClass>
    <canHaveFaction>true</canHaveFaction>
    <saved>true</saved>
    <selectable>true</selectable>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>60</expandingIconPriority>
    <mapGenerator>DMSE_SeaLaunchSite_MapGen</mapGenerator>
    <comps>
      <!-- 沒有 WorldObjectCompProperties_FormCaravan：水域 tile 上不能組遠行隊，只能空中撤離。 -->
      <li Class="Fortified.WorldObjectCompProperties_AirDefense">
        <worldDetectionRange>12</worldDetectionRange>
        <antiStealthLevel>2</antiStealthLevel>
        <fireControlDef>DMSE_FireControlRadar</fireControlDef>
        <channels>3</channels>
        <interceptorStock>6</interceptorStock>
        <restockPerDay>3</restockPerDay>
        <interceptorBody>DMSE_MissileBody_Light</interceptorBody>
        <interceptorWarhead>DMSE_Light_Warhead_ContinuousRod</interceptorWarhead>
        <launchCooldownTicks>300</launchCooldownTicks>
        <worldInterceptRange>7</worldInterceptRange>
      </li>
      <li Class="Fortified.WorldObjectCompProperties_MissileBase">
        <missileFireIntervalDays>
          <min>2.5</min>
          <max>4</max>
        </missileFireIntervalDays>
        <missilesPerSalvo>
          <min>1</min>
          <max>3</max>
        </missilesPerSalvo>
        <!-- 基本彈：先進通用導彈（地獄火，射程約 48 格），成像或紅外導引 -->
        <missileBody>DMSE_MissileBody_AdvancedLight</missileBody>
        <partOptions>
          <li>
            <category>Warhead</category>
            <parts>
              <li>DMSE_AdvLight_Warhead_HEAT</li>
              <li>DMSE_AdvLight_Warhead_BlastFrag</li>
            </parts>
          </li>
          <li>
            <category>Guidance</category>
            <parts>
              <li>DMSE_AdvLight_Guidance_Imaging</li>
              <li>DMSE_AdvLight_Guidance_IIR</li>
            </parts>
          </li>
          <li>
            <category>Payload</category>
            <parts>
              <li>DMSE_AdvLight_Payload_None</li>
            </parts>
          </li>
        </partOptions>
        <!-- 依目標防空能力調整（E = min(火控通道, 有彈攔截發射平台)），從高梯次往下擲，打不到目標時退回基本彈：
             E≥2 帶干擾絲的先進通用彈；E≥3 反輻射彈（只有輕型彈體有）；E≥4 縞瑪瑙（2.7 倍世界速度，攔截窗口短）；
             E≥5 匿蹤先進巡航彈（含誘餌型）。 -->
        <adaptiveSalvo>
          <alpha>0.8</alpha>
          <exponent>0.7</exponent>
          <maxPerSalvo>5</maxPerSalvo>
          <tiers>
            <li>
              <minEffective>2</minEffective>
              <chance>0.35</chance>
              <missileBody>DMSE_MissileBody_AdvancedLight</missileBody>
              <partOptions>
                <li>
                  <category>Warhead</category>
                  <parts>
                    <li>DMSE_AdvLight_Warhead_HEAT</li>
                  </parts>
                </li>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_AdvLight_Guidance_MMW</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_AdvLight_Payload_Chaff</li>
                  </parts>
                </li>
              </partOptions>
            </li>
            <li>
              <minEffective>3</minEffective>
              <chance>0.3</chance>
              <missileBody>DMSE_MissileBody_Light</missileBody>
              <partOptions>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_Light_Guidance_AntiRadiation</li>
                  </parts>
                </li>
              </partOptions>
            </li>
            <li>
              <minEffective>4</minEffective>
              <chance>0.3</chance>
              <missileBody>DMSE_MissileBody_Oniks</missileBody>
              <partOptions>
                <li>
                  <category>Warhead</category>
                  <parts>
                    <li>DMSE_Warhead_HE</li>
                  </parts>
                </li>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_Guidance_AntiShip</li>
                  </parts>
                </li>
                <li>
                  <category>Propulsion</category>
                  <parts>
                    <li>DMSE_Propulsion_Standard</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_Payload_None</li>
                  </parts>
                </li>
              </partOptions>
            </li>
            <li>
              <minEffective>5</minEffective>
              <chance>0.35</chance>
              <missileBody>DMSE_MissileBody_AdvancedCruise</missileBody>
              <partOptions>
                <li>
                  <category>Guidance</category>
                  <parts>
                    <li>DMSE_AdvCruise_Guidance_TerrainMatch</li>
                    <li>DMSE_AdvCruise_Guidance_Datalink</li>
                  </parts>
                </li>
                <li>
                  <category>Payload</category>
                  <parts>
                    <li>DMSE_AdvCruise_Payload_None</li>
                    <li>DMSE_AdvCruise_Payload_Decoy</li>
                  </parts>
                </li>
              </partOptions>
            </li>
          </tiers>
        </adaptiveSalvo>
        <range>18</range>
        <relocationDays>
          <min>12</min>
          <max>24</max>
        </relocationDays>
        <reentryBlockedDays>
          <min>0.5</min>
          <max>1</max>
        </reentryBlockedDays>
        <incomingWorldObjectDef>DMSE_WorldObject_IncomingMissile</incomingWorldObjectDef>
        <!-- 補給、彈架與砲塔彈藥同野戰陣地 -->
        <supplyDrop>
          <intervalDays>2~4</intervalDays>
          <perPawn>8</perPawn>
          <maxStockPerPawn>12</maxStockPerPawn>
        </supplyDrop>
        <rackSupply>
          <intervalDays>2~4</intervalDays>
          <loadDelayTicks>2500</loadDelayTicks>
          <!-- 守軍自行從彈藥庫搬彈裝填發射架，同時最多 2 人。有相容彈的彈藥庫時，空發射架不另外空投。 -->
          <maxCrewLoaders>2</maxCrewLoaders>
          <!-- 太空等級：彈架裝先進彈。可裝配彈（先進通用、先進巡航）裝填時依彈體預設部件組裝；清單內重複的項目＝較高權重。
               兩用的灰熊留一些在輕型架上，讓火控網路有彈可攔截。 -->
          <loadouts>
            <li>
              <!-- 平台 C 的彈藥庫：供輕型垂直發射單元 -->
              <rack>DMSE_FieldStructure_AmmoStorage</rack>
              <missiles>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedCruise</li>
                <li>DMSE_Missile_Grison</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_Building_LightMissileLauncher</rack>
              <missiles>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedCruise</li>
                <li>DMSE_Missile_Grison</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_Building_LightMissileVLS</rack>
              <missiles>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedCruise</li>
                <li>DMSE_Missile_AdvancedCruise</li>
                <li>DMSE_Missile_Grison</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_MissileRack</rack>
              <missiles>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_AdvancedLight</li>
                <li>DMSE_Missile_Grison</li>
              </missiles>
            </li>
            <li>
              <!-- 平台 B 的巡航導彈架：供中型垂直發射單元 -->
              <rack>DMSE_CruiseMissileRack</rack>
              <missiles>
                <li>DMSE_Missile_Oniks</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_Building_MediumVLS</rack>
              <missiles>
                <li>DMSE_Missile_Oniks</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_Building_RotaryMissileLauncher</rack>
              <missiles>
                <li>DMSE_InterceptorMissile</li>
                <li>DMSE_Missile_Grison</li>
              </missiles>
            </li>
            <li>
              <rack>DMSE_Building_FieldAirDefense</rack>
              <missiles>
                <li>DMSE_InterceptorMissile</li>
                <li>DMSE_Missile_Stinger</li>
              </missiles>
            </li>
          </loadouts>
        </rackSupply>
        <turretAmmo>
          <intervalDays>2~4</intervalDays>
          <refillBelowPercent>0.5</refillBelowPercent>
          <refillToPercent>1</refillToPercent>
          <haulDelayTicks>300</haulDelayTicks>
          <maxHaulers>1</maxHaulers>
        </turretAmmo>
      </li>
    </comps>
  </WorldObjectDef>

  <SitePartDef>
    <defName>DMSE_SeaLaunchSitePart</defName>
    <label>sea launch station</label>
    <description>An offshore missile station on pillar-supported sea platforms, with radars and launch platforms armed with advanced missiles.</description>
    <workerClass>Fortified.SitePartWorker_SeaLaunchSite</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>UI/Icon/icon_Marine_cruiser</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <requiresFaction>true</requiresFaction>
    <tags>
      <li>DMSE_SeaLaunchSite</li>
    </tags>
    <wantsThreatPoints>true</wantsThreatPoints>
    <forceExitAndRemoveMapCountdownDurationDays>0</forceExitAndRemoveMapCountdownDurationDays>
    <modExtensions>
      <!-- 只有武裝殖民艦隊（DMS 本體）會部署 -->
      <li Class="Fortified.SeaLaunchSiteFactionExtension">
        <factions>
          <li>DMS_Army</li>
        </factions>
      </li>
    </modExtensions>
  </SitePartDef>

  <!-- 說書人觸發的大型威脅：敵對的武裝殖民艦隊在殖民地附近海面部署海上發射站。
       需要雷達網研究、殖民艦隊與玩家敵對、附近有空的水域 tile；世界上已有 NPC 導彈陣地（任何種類）時不觸發。 -->
  <IncidentDef>
    <defName>DMSE_SeaLaunchSiteDeployed</defName>
    <label>sea launch station deployed</label>
    <category>ThreatBig</category>
    <!-- 只認家園地圖（同 DMSE_FieldLaunchSiteDeployed）。原本另列 World 給開發者在世界地圖上強制觸發，
         但 1.7 的設定檢查不允許 World 與其他目標並列（Config error：World targeting incidents should only target the world）；
         開發者改在家園地圖上用「執行事件」強制觸發即可。 -->
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Fortified.IncidentWorker_SeaLaunchSite</workerClass>
    <baseChance>0.5</baseChance>
    <earliestDay>20</earliestDay>
    <minRefireDays>25</minRefireDays>
    <minThreatPoints>500</minThreatPoints>
    <letterLabel>Colonial fleet sea launch station</letterLabel>
    <letterDef>ThreatBig</letterDef>
    <modExtensions>
      <li Class="Fortified.FieldLaunchSiteIncidentExtension">
        <worldObjectDef>DMSE_SeaLaunchSite</worldObjectDef>
        <sitePartDef>DMSE_SeaLaunchSitePart</sitePartDef>
        <distance>4~14</distance>
        <maxActiveSites>1</maxActiveSites>
        <threatPoints>500~3500</threatPoints>
        <requiredResearch>DMSE_RadarNetwork</requiredResearch>
        <spawnedLetterKey>DMSE.SeaLaunchSite.SpawnedLetter</spawnedLetterKey>
      </li>
    </modExtensions>
  </IncidentDef>

</Defs>
