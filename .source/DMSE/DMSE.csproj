<Project Sdk="Microsoft.NET.Sdk">

  <!--
    只建置 RimWorld 1.7（.NET 10 / Waylith / Harmony 3）→ 1.7/Assemblies，並定義 RW_1_7。
    1.6 凍結在 Steam 創意工坊版，1.6/Assemblies/DMSE.dll 是該版的 DLL，不再由本專案產生（開發版封存於標籤 dmse-1.6-dev-sealed）。
    1.7 沒有參考組件套件，直接參考遊戲本體的 DLL；預設假設本模組位於 <RimWorld>/Mods/<模組>/，
    遊戲裝在別處時以 -p:RimWorldDir=<遊戲目錄>\ 覆寫。
    Builds RimWorld 1.7 only (.NET 10 / Waylith / Harmony 3) into 1.7/Assemblies and defines RW_1_7.
    1.6 is frozen at the Steam Workshop release; 1.6/Assemblies/DMSE.dll is that release's DLL and is no longer produced here
    (the development state is tagged dmse-1.6-dev-sealed).
    1.7 has no reference-assembly package, so the game's own DLLs are referenced; override the game path
    with -p:RimWorldDir=<game dir>\ when the mod is not under <RimWorld>/Mods/<mod>/.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DMSE</RootNamespace>
    <AssemblyName>DMSE</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs 已提供組件屬性。Properties/AssemblyInfo.cs already supplies the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);RW_1_7</DefineConstants>
    <!-- 遊戲只載入 Assemblies 內的 .dll，不需要 DMSE.deps.json。The game only loads the .dll, so no deps.json. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 舊專案也沒有編譯這個檔案。The old project did not compile this file either. -->
    <Compile Remove="FactionGoodwill_Patch.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 與 Harmony 模組 1.7 資料夾內的 0Harmony.dll 完全相同（3.0.0-rc.2）。Identical to the Harmony mod's 1.7 0Harmony.dll. -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 1.7 的 UnityEngine.* 型別全部由 UnityStubs 提供。In 1.7 every UnityEngine.* type comes from UnityStubs. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 野戰發射陣地組合多座 FFF 結構（GenStep_FieldLaunchSite）。AOBA.Framework 由 DMS Core 載入。
         The field launch site composes several FFF structures; AOBA.Framework is loaded through DMS Core. -->
    <Reference Include="Fortified">
      <HintPath>$(RimWorldDir)Mods\_Fortified-Framework\1.7\Assemblies\Fortified.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
