<?xml version="1.0" encoding="utf-8"?>
<!--
  Generator-only launch templates for .source/Tools/gen_missile_launch_defs.py. NOT loaded by the game
  (this file is outside 1.7/Defs). The ballistic and cruise bodies these skyfallers belonged to were retired
  on 2026-10-27 (merged into AdvancedBallistic and Moskit); their <skyfaller> flight curves and launch comps are
  still the flight family of LegacyBallistic, AdvancedBallistic and Tochka (ballistic) and of AdvancedCruise,
  Moskit and Yj (cruise). Edit flight curves here, then rerun the generator.
-->
<Defs>

  <ThingDef ParentName="SkyfallerBase">
    <defName>DMSE_SkyFaller_BallisticMissile</defName>
    <label>ballistic missile (leaving)</label>
    <thingClass>DMSE.ScorerProjectile</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Missile/Moskit/skyFaller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>4.66</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Accelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(2.5, 2.5)</shadowSize>
      <ticksToDiscardInReverse>300</ticksToDiscardInReverse>
      <ticksToImpactRange>0</ticksToImpactRange>
      <anticipationSound>DropPod_Leaving</anticipationSound>
      <anticipationSoundTicks>-1</anticipationSoundTicks>
      <speedCurve>
        <points>
          <li>(0,0.1)</li>
          <li>(0.2,0.5)</li>
          <li>(0.5,1.5)</li>
          <li>(1,3)</li>
        </points>
      </speedCurve>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.5,0)</li>
          <li>(1,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.1,3)</li>
          <li>(0.4,1)</li>
          <li>(1,20)</li>
        </points>
      </zPositionCurve>
    </skyfaller>
    <comps>
      <li Class="DMSE.CompProperties_EffecterColdLaunch">
        <delayTicks>20</delayTicks>
        <ignitionSound>DMSE_Missile_Flight</ignitionSound>
        <ExhaustFleck>DMS_Fleck_RocketFlame</ExhaustFleck>
        <ExhaustCurve>
          <points>
            <li>(0,3)</li>
            <li>(0.1,12)</li>
            <li>(0.5,8)</li>
            <li>(0.9,3)</li>
          </points>
        </ExhaustCurve>
        <SmokeFleck>Smoke</SmokeFleck>
        <SmokeCurve>
          <points>
            <li>(0,16)</li>
            <li>(0.5,10)</li>
            <li>(1,3)</li>
          </points>
        </SmokeCurve>
        <launchEffectTrigger>DMS_LaunchDust_Recoilless</launchEffectTrigger>
      </li>
    </comps>
  </ThingDef>

    <ThingDef ParentName="SkyfallerBase">
        <defName>DMSE_SkyFaller_CruiseMissile</defName>
        <label>cruise missile (leaving)</label>
        <size>(1,1)</size>
        <graphicData>
            <texPath>Things/Missile/Moskit/skyFaller</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>3.11</drawSize>
        </graphicData>
        <thingClass>DMSE.ScorerProjectile</thingClass>
        <skyfaller>
            <movementType>Accelerate</movementType>
            <reversed>true</reversed>
            <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
            <shadowSize>(2, 2)</shadowSize>
            <ticksToDiscardInReverse>300</ticksToDiscardInReverse>
            <ticksToImpactRange>0</ticksToImpactRange>
            <anticipationSound>DropPod_Leaving</anticipationSound>
            <anticipationSoundTicks>-1</anticipationSoundTicks>
            <speedCurve>
                <points>
                    <li>(0,0.3)</li>
                    <li>(0.2,0.2)</li>
                    <li>(0.5,0.5)</li>
                    <li>(1,1)</li>
                </points>
            </speedCurve>
            <rotationCurve>
                <points>
                    <li>(0,-10)</li>
                    <li>(0.30,-25)</li>
                    <li>(0.6,-5)</li>
                    <li>(1,0)</li>
                </points>
            </rotationCurve>
            <zPositionCurve>
                <points>
                    <li>(0,0)</li>
                    <li>(0.05,2)</li>
                    <li>(0.3,1)</li>
                    <li>(1,10)</li>
                </points>
            </zPositionCurve>
        </skyfaller>
        <comps>
            <li Class="DMSE.CompProperties_EffecterColdLaunch">
                <delayTicks>40</delayTicks>
                <ignitionSound>DMSE_Missile_Flight</ignitionSound>
                <ExhaustFleck>DMS_Fleck_RocketFlame</ExhaustFleck>
                <ExhaustCurve>
                    <points>
                        <li>(0,2)</li>
                        <li>(0.1,8)</li>
                        <li>(0.5,4)</li>
                        <li>(0.9,2)</li>
                    </points>
                </ExhaustCurve>
                <SmokeFleck>Smoke</SmokeFleck>
                <SmokeCurve>
                    <points>
                        <li>(0,12)</li>
                        <li>(0.5,9)</li>
                        <li>(1,2)</li>
                    </points>
                </SmokeCurve>
                <launchEffectTrigger>DMS_LaunchDust_Recoilless</launchEffectTrigger>
            </li>
        </comps>
    </ThingDef>

</Defs>
