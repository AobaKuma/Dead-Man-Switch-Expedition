<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-game BVR acceptance runner (RimWorld 1.7). Builds a separate assembly that is copied into
    1.7/Assemblies only for the duration of an acceptance run (see run.ps1) and removed afterwards.
    It does nothing unless the game is started with -dmse-bvr-acceptance=<output dir>.
    Never ship this DLL with the mod.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DMSE.BVRAcceptance</RootNamespace>
    <AssemblyName>DMSE.BVRAcceptance</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DMSE">
      <HintPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\DMSE.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
